import Mathlib.NumberTheory.Primorial
import Mathlib.NumberTheory.SmoothNumbers

/-!
# Rough numbers

An integer is `y`-rough when every prime dividing it exceeds `y`.  The sieve argument, the
conditional orthogonality relation and the rough–smooth factorisation all need this notion, and
each would otherwise carry its own translation lemma, so it is fixed here once.

## The definition

`RMF.IsRough y n` is `Nat.Coprime (primorial y) n`, and `RMF.isRough_iff` identifies it with
`∀ p, p.Prime → p ∣ n → y < p`.  Coprimality to the primorial is the right primitive:

* it is exactly what an upper-bound sieve sifts by, so the statement of the sieve estimate needs
  no translation (`Mathlib.NumberTheory.SelbergSieve` bounds a sum over `Coprime prodPrimes n`);
* it is what places `f n` in the σ-algebra generated by the primes above `y`;
* it avoids an off-by-one.  Mathlib's `Nat.smoothNumbers N` is defined by the *strict* `p < N`,
  so "`y`-smooth" is `Nat.smoothNumbers (y + 1)`; `RMF.mem_smoothNumbers_succ_iff` records the
  `≤` form once, and no other file need mention the `+ 1`.

Beware `Nat.roughNumbersUpTo`, which is a different notion: it collects the integers that are
*not* smooth, i.e. those with **some** large prime factor, rather than those all of whose prime
factors are large.
-/

namespace RMF

open Nat

/-- `n` is `y`-rough, `Nat.Coprime (primorial y) n`: no prime at most `y` divides it, equivalently
every prime dividing `n` exceeds `y` (`RMF.isRough_iff`). -/
def IsRough (y n : ℕ) : Prop := Nat.Coprime (primorial y) n

instance (y n : ℕ) : Decidable (IsRough y n) := inferInstanceAs (Decidable (_ = 1))

/-- **The characterisation of roughness.**  Note that `0` is not `y`-rough for `y ≥ 2`, since
every prime divides it. -/
theorem isRough_iff {y n : ℕ} : IsRough y n ↔ ∀ p, p.Prime → p ∣ n → y < p := by
  rw [IsRough, ← not_iff_not, Nat.Prime.not_coprime_iff_dvd]
  push Not
  refine exists_congr fun p => and_congr_right fun hp => ?_
  rw [hp.dvd_primorial_iff, and_comm]

/-- Smoothness in the `≤` form, so that no other file mentions the `+ 1` forced by Mathlib's
strict convention. -/
theorem mem_smoothNumbers_succ_iff {y n : ℕ} :
    n ∈ Nat.smoothNumbers (y + 1) ↔ ∀ p, p.Prime → p ∣ n → p ≤ y := by
  simp only [Nat.mem_smoothNumbers', Nat.lt_succ_iff]

@[simp]
theorem isRough_one (y : ℕ) : IsRough y 1 := Nat.coprime_one_right _

/-- **A rough integer above `1` exceeds `y`.**  Its least prime factor divides it, hence is
`> y`, and is at most the integer itself.

This is what makes the sieve usable at `η = y^{-1/2}`: the interval `[r, r(1+η)]` sits above `y`,
so the sifting range `rη/(1+η)` is at least of size `√y`. -/
theorem IsRough.lt_of_one_lt {y n : ℕ} (h : IsRough y n) (hn : 1 < n) : y < n := by
  have hp : (n.minFac).Prime := Nat.minFac_prime (by omega)
  exact lt_of_lt_of_le (isRough_iff.1 h _ hp (Nat.minFac_dvd n)) (Nat.minFac_le (by omega))

theorem isRough_mul_iff {y m n : ℕ} : IsRough y (m * n) ↔ IsRough y m ∧ IsRough y n :=
  Nat.coprime_mul_iff_right

theorem IsRough.of_dvd {y m n : ℕ} (h : IsRough y n) (hmn : m ∣ n) : IsRough y m :=
  Nat.Coprime.coprime_dvd_right hmn h

/-- A rough number and a smooth number are coprime: a common prime factor would have to both
exceed `y` and be at most `y`. -/
theorem IsRough.coprime_of_mem_smoothNumbers {y m n : ℕ} (hm : IsRough y m)
    (hn : n ∈ Nat.smoothNumbers (y + 1)) : Nat.Coprime m n := by
  by_contra hc
  obtain ⟨p, hp, hpm, hpn⟩ := Nat.Prime.not_coprime_iff_dvd.1 hc
  exact absurd (isRough_iff.1 hm p hp hpm)
    (not_lt.2 (mem_smoothNumbers_succ_iff.1 hn p hp hpn))

/-! ## The rough–smooth factorisation

Every `n ≠ 0` factors as `n = (rough part) · (smooth part)`, uniquely.  Mathlib has no such
splitting: `Nat.equivProdNatFactoredNumbers` peels off a *single* prime, which is the induction
step for Euler products, not this.  It is built here from `Nat.factorization` by splitting the
support at `y`.

Uniqueness does not go through the construction at all — it is pure coprimality, which is why it
is stated for arbitrary factorisations rather than for `roughPart`/`smoothPart`. -/

/-- The `y`-rough part of `n`: the product of the prime powers `p^{v_p(n)}` with `p > y`. -/
def roughPart (y n : ℕ) : ℕ := ∏ p ∈ {p ∈ n.primeFactors | y < p}, p ^ n.factorization p

/-- The `y`-smooth part of `n`: the product of the prime powers `p^{v_p(n)}` with `p ≤ y`. -/
def smoothPart (y n : ℕ) : ℕ :=
  ∏ p ∈ {p ∈ n.primeFactors | p ≤ y}, p ^ n.factorization p

/-- **The factorisation.**  Splitting `n = ∏_p p^{v_p(n)}` at `y`. -/
theorem roughPart_mul_smoothPart (y : ℕ) {n : ℕ} (hn : n ≠ 0) :
    roughPart y n * smoothPart y n = n := by
  rw [roughPart, smoothPart,
    show {p ∈ n.primeFactors | p ≤ y} = {p ∈ n.primeFactors | ¬ y < p} by simp only [not_lt],
    Finset.prod_filter_mul_prod_filter_not]
  exact Nat.prod_factorization_pow_eq_self hn

theorem roughPart_pos (y n : ℕ) : 0 < roughPart y n :=
  Finset.prod_pos fun _ hp =>
    pow_pos (Nat.prime_of_mem_primeFactors (Finset.mem_filter.1 hp).1).pos _

theorem smoothPart_pos (y n : ℕ) : 0 < smoothPart y n :=
  Finset.prod_pos fun _ hp =>
    pow_pos (Nat.prime_of_mem_primeFactors (Finset.mem_filter.1 hp).1).pos _

theorem isRough_roughPart (y n : ℕ) : IsRough y (roughPart y n) := by
  rw [isRough_iff]
  intro p hp hdvd
  rw [roughPart, hp.prime.dvd_finsetProd_iff] at hdvd
  obtain ⟨q, hq, hpq⟩ := hdvd
  obtain ⟨hq1, hq2⟩ := Finset.mem_filter.1 hq
  have hpe : p = q :=
    (Nat.prime_dvd_prime_iff_eq hp (Nat.prime_of_mem_primeFactors hq1)).1 (hp.dvd_of_dvd_pow hpq)
  omega

theorem smoothPart_mem_smoothNumbers (y n : ℕ) :
    smoothPart y n ∈ Nat.smoothNumbers (y + 1) := by
  rw [mem_smoothNumbers_succ_iff]
  intro p hp hdvd
  rw [smoothPart, hp.prime.dvd_finsetProd_iff] at hdvd
  obtain ⟨q, hq, hpq⟩ := hdvd
  obtain ⟨hq1, hq2⟩ := Finset.mem_filter.1 hq
  have hpe : p = q :=
    (Nat.prime_dvd_prime_iff_eq hp (Nat.prime_of_mem_primeFactors hq1)).1 (hp.dvd_of_dvd_pow hpq)
  omega

theorem roughPart_dvd (y : ℕ) {n : ℕ} (hn : n ≠ 0) : roughPart y n ∣ n :=
  Dvd.intro _ (roughPart_mul_smoothPart y hn)

theorem smoothPart_dvd (y : ℕ) {n : ℕ} (hn : n ≠ 0) : smoothPart y n ∣ n :=
  Dvd.intro_left _ (roughPart_mul_smoothPart y hn)

/-- **Uniqueness**, and it is nothing but coprimality: `m ∣ m'k'` with `m` rough and `k'` smooth
forces `m ∣ m'`, and symmetrically. -/
theorem rough_smooth_unique {y m k m' k' : ℕ} (hm : IsRough y m)
    (hk : k ∈ Nat.smoothNumbers (y + 1)) (hm' : IsRough y m')
    (hk' : k' ∈ Nat.smoothNumbers (y + 1)) (hpos : 0 < m) (h : m * k = m' * k') :
    m = m' ∧ k = k' := by
  have hmm' : m ∣ m' := (hm.coprime_of_mem_smoothNumbers hk').dvd_of_dvd_mul_right ⟨k, h.symm⟩
  have hm'm : m' ∣ m := (hm'.coprime_of_mem_smoothNumbers hk).dvd_of_dvd_mul_right ⟨k', h⟩
  have hEq : m = m' := Nat.dvd_antisymm hmm' hm'm
  subst hEq
  exact ⟨rfl, Nat.eq_of_mul_eq_mul_left hpos h⟩

/-- The two parts of a product of a rough and a smooth number are the two factors. -/
theorem roughPart_smoothPart_mul {y m k : ℕ} (hm : IsRough y m)
    (hk : k ∈ Nat.smoothNumbers (y + 1)) (hpos : 0 < m) :
    roughPart y (m * k) = m ∧ smoothPart y (m * k) = k := by
  have hk0 : k ≠ 0 := Nat.ne_zero_of_mem_smoothNumbers hk
  have hn : m * k ≠ 0 := Nat.mul_ne_zero hpos.ne' hk0
  exact rough_smooth_unique (isRough_roughPart y _) (smoothPart_mem_smoothNumbers y _) hm hk
    (roughPart_pos y _) (by rw [roughPart_mul_smoothPart y hn])

end RMF
