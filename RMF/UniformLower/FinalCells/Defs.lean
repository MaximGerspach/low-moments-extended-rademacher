import RMF.UniformLower.FinalHelpers

/-!
# The final assembly: the log-space bounds

Generated by a script.

The functions the certificates of `RMF/UniformLower/FinalCells.lean` bound below on cells of `q`:
`RMF.cellLogCore`, `RMF.cellLogMain`, `RMF.cellLogErr`, `RMF.cellLogHalfCore`, and for the mid
range `RMF.cellLogMainMid`, `RMF.cellLogErrMid`.
-/

namespace RMF

/-! ### The log-space bounds -/

/-- **The core's log on a cell `[a, b] ⊆ (0, ½]`**, every term at its worse end: the log of
`cRed(q)2^{2q-1}(e^{-0.592}q/128)^qΓ(q)` with `c₃ ≥ c`, `q log q ≥ ℓ`. -/
noncomputable def cellLogCore (a b c ℓ : ℝ) : ℝ :=
  -((1 - a) * Real.log 3) - (1 - 2 * a) * Real.log 2 - b * Real.log (16 * 3.1416)
    + (2 * a - 1) * Real.log 2 + b * (-0.592 - 7 * Real.log 2) + ℓ + (2 - a) * Real.log c
    - (1 - a) * (2 * (1 - a) + 0.50001) - b * Real.log 2 + (2 - a) * Real.log 0.3165
    - (1 - a) * Real.log 6482

/-- **B1's main term on a cell**: `(1 - 2b)`, the core, and `N ≥ e^{-21.7867β}`, `β ≥ q(1-2q)`. -/
noncomputable def cellLogMain (a b c β ℓ : ℝ) : ℝ :=
  Real.log (1 - 2 * b) + cellLogCore a b c ℓ - β * 21.7867

/-- **The error term's log on a cell `q ≤ b ≤ ½`**: `log cErr(b) - (1376/1377)u`. -/
noncomputable def cellLogErr (b u : ℝ) : ℝ :=
  -((1 - b) * Real.log 3) - (1 - 2 * b) * Real.log 2 + b * Real.log 16 - 1376 / 1377 * u

/-- **The core's log on a cell `[a, b] ⊆ [½, 1]`**: the log of `cRed(q)2^{2q-1}(G/128)^qΓ(q)`,
`G = e^{-0.592}/2`, with `c₃ ≥ c`. -/
noncomputable def cellLogHalfCore (a b c : ℝ) : ℝ :=
  -((1 - a) * Real.log 3) - b * Real.log (16 * 3.1416) + (2 * a - 1) * Real.log 2
    + b * (-0.592 - 8 * Real.log 2) + (2 - a) * Real.log c - (1 - a) * (2 * (1 - a) + 0.50001)
    - b * Real.log 2 + (2 - a) * Real.log 0.3165 - (1 - a) * Real.log 6482

/-! ### The mid range `2100 ≤ log log x ≤ 6000`: the log-space bounds

Below `½` at the reduction's tilt `V′ = 32/q + 6000`: the main terms are B1's and B2's times
`(32/(32 + 6000q))^q`, and the error term's exponent is `(545/546)max(37/2, 2100q)`. -/

/-- **B1″'s main term on a cell**: B1's, and `(32/(32 + 6000q))^q ≥ e^{-b log(1 + 375b/2)}`. -/
noncomputable def cellLogMainMid (a b c β ℓ : ℝ) : ℝ :=
  cellLogMain a b c β ℓ - b * Real.log (1 + 375 / 2 * b)

/-- **The error term's log on a cell `q ≤ b ≤ ½`, mid range**: `log cErr(b) - (545/546)u`. -/
noncomputable def cellLogErrMid (b u : ℝ) : ℝ :=
  -((1 - b) * Real.log 3) - (1 - 2 * b) * Real.log 2 + b * Real.log 16 - 545 / 546 * u

end RMF
