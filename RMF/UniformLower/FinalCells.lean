  · exact finalB1Cell_17 h16.le h17
  exact finalB1Cell_18 h17.le (by linarith)

/-! ### B2, H, S: one cell each; F and L -/

/-- B2, `q ∈ [9/20, ½)`, the main term (log-space bound `-18.242728`). -/
theorem finalB2Main : (-18.244 : ℝ) ≤ Real.log (3 / 5)
    + cellLogCore (9 / 20) (1 / 2) 0.17784 (9 / 20 * Real.log (9 / 20))
    - 9 / 20 * (1 - 2 * (9 / 20)) * 20.7867 - 1 / 2 := by
  unfold cellLogCore
  interval_decide (trust := kernel)

/-- B2, the rest (log-slack `4.755`, certified `PhiB2 ≥ 119.3·10⁻¹⁰`). -/
theorem finalB2Err : 1 / 10 ^ 10 + 216 * Real.exp (-32) + Real.exp (cellLogErr (1 / 2) 2700)
    ≤ Real.exp (-18.244) := by
  unfold cellLogErr
  interval_decide (trust := kernel)

/-- H, `q = ½`, the main term (log-space bound `-15.48359`). -/
theorem finalHMain :
    (-15.485 : ℝ) ≤ cellLogHalfCore (1 / 2) (1 / 2) 0.23292 + Real.log (3 / 5) := by
  unfold cellLogHalfCore
  interval_decide (trust := kernel)

/-- H, the rest (log-slack `0.6331`, certified `cHalfLB ≥ 1.8834e-7`). -/
theorem finalHErr : 1 / 10 ^ 7 + 173 / 10 * Real.exp (-32) + 16 * Real.exp (-3000)
    ≤ Real.exp (-15.485) := by
  interval_decide (trust := kernel)

/-- S, `q ∈ (½, ½ + 1/(2·10⁸)]`, the main term (log-space bound `-15.916012`). -/
theorem finalSMain : (-15.917 : ℝ)
    ≤ cellLogHalfCore (1 / 2) (1 / 2 + 1 / (2 * 10 ^ 8)) 0.23292 + Real.log (1 / 2)
      - (1 / 2 + 1 / (2 * 10 ^ 8)) / 2 - 1 / 10 ^ 4 := by
  unfold cellLogHalfCore
  interval_decide (trust := kernel)

/-- S, the rest (log-slack `7.105`, certified `PhiSl ≥ 1222.7·10⁻¹⁰`). -/
theorem finalSErr : 1 / 10 ^ 10 + 33 * Real.exp (-32) + 16 * Real.exp (-3000)
    ≤ Real.exp (-15.917) := by
  interval_decide (trust := kernel)

/-- F, the floor's numeral (margin `×15.27`). -/
theorem finalF : (1 : ℝ) / 10 ^ 10
    ≤ 1 / 6 * Real.exp (37 / 12000 * Real.log (49 / 100)) * Real.exp (-(37 / 2))
      * (1 - 37 / 6000) := by
  interval_decide (trust := kernel)

/-- L, Lyapunov's numeral (margin `×60.65`). -/
theorem finalL : (1 : ℝ) / 10 ^ 10 * Real.exp (1 / 2 + 1 / (2 * 10 ^ 8))
    ≤ Real.exp ((1 + 1 / 10 ^ 8) * Real.log (1 / 10 ^ 8)) := by
  interval_decide (trust := kernel)

/-! ### The dispatcher -/

/-- **Every certificate of the final assembly**: B1's cells, then B2, H, S, F and L. -/
theorem finalCells_spec :
    (∀ q : ℝ, 0 < q → q ≤ 9 / 20 →
      ∃ a b c β ℓ u lam : ℝ, a ≤ q ∧ q ≤ b ∧ b ≤ 9 / 20 ∧ 0 < c ∧ c ≤ 1 ∧ c ≤ c3FloorK q 1
        ∧ q * (1 - 2 * q) ≤ β ∧ ℓ ≤ q * Real.log q ∧ u ≤ max (37 / 2) (6000 * a)
        ∧ lam ≤ cellLogMain a b c β ℓ
        ∧ 1 / 10 ^ 10 + 216 * Real.exp (-32) + Real.exp (cellLogErr b u) ≤ Real.exp lam)
    ∧ (∃ lam : ℝ, lam ≤ Real.log (3 / 5)
        + cellLogCore (9 / 20) (1 / 2) 0.17784 (9 / 20 * Real.log (9 / 20))
        - 9 / 20 * (1 - 2 * (9 / 20)) * 20.7867 - 1 / 2
      ∧ 1 / 10 ^ 10 + 216 * Real.exp (-32) + Real.exp (cellLogErr (1 / 2) 2700) ≤ Real.exp lam)
    ∧ (∃ lam : ℝ, lam ≤ cellLogHalfCore (1 / 2) (1 / 2) 0.23292 + Real.log (3 / 5)
      ∧ 1 / 10 ^ 7 + 173 / 10 * Real.exp (-32) + 16 * Real.exp (-3000) ≤ Real.exp lam)
    ∧ (∃ lam : ℝ, lam
        ≤ cellLogHalfCore (1 / 2) (1 / 2 + 1 / (2 * 10 ^ 8)) 0.23292 + Real.log (1 / 2)
          - (1 / 2 + 1 / (2 * 10 ^ 8)) / 2 - 1 / 10 ^ 4
      ∧ 1 / 10 ^ 10 + 33 * Real.exp (-32) + 16 * Real.exp (-3000) ≤ Real.exp lam)
    ∧ (1 : ℝ) / 10 ^ 10
      ≤ 1 / 6 * Real.exp (37 / 12000 * Real.log (49 / 100)) * Real.exp (-(37 / 2))
        * (1 - 37 / 6000)
    ∧ (1 : ℝ) / 10 ^ 10 * Real.exp (1 / 2 + 1 / (2 * 10 ^ 8))
      ≤ Real.exp ((1 + 1 / 10 ^ 8) * Real.log (1 / 10 ^ 8)) :=
  ⟨fun _ hq0 hq => finalB1_spec hq0 hq, ⟨_, finalB2Main, finalB2Err⟩,
    ⟨_, finalHMain, finalHErr⟩, ⟨_, finalSMain, finalSErr⟩, finalF, finalL⟩

