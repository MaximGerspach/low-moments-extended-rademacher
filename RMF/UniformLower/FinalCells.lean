      ∃ a b c β ℓ u lam : ℝ, a ≤ q ∧ q ≤ b ∧ b ≤ 9 / 20 ∧ 0 < c ∧ c ≤ 1 ∧ c ≤ c3FloorK q 1
        ∧ q * (1 - 2 * q) ≤ β ∧ ℓ ≤ q * Real.log q ∧ u ≤ max (37 / 2) (2100 * a)
        ∧ lam ≤ cellLogMainMid a b c β ℓ
        ∧ 1 / 10 ^ 10 + Real.exp (-32) + Real.exp (cellLogErrMid b u) ≤ Real.exp lam)
    ∧ (∃ lam : ℝ, lam ≤ Real.log (1 / 2)
        + cellLogCore (9 / 20) (1 / 2) 0.17784 (9 / 20 * Real.log (9 / 20))
        - 9 / 20 * (1 - 2 * (9 / 20)) * 20.7867 - 1 / 2
        - 1 / 2 * Real.log (1 + 375 / 2 * (1 / 2))
      ∧ 1 / 10 ^ 10 + Real.exp (-32) + Real.exp (cellLogErrMid (1 / 2) 945) ≤ Real.exp lam)
    ∧ (1 : ℝ) / 10 ^ 10 * Real.exp ((3 / 4 + 3 / 1400) * Real.log 6000) * Real.exp 18
      ≤ 18 * Real.exp (-(3 / 350 * Real.log 2))
    ∧ (1 : ℝ) / 10 ^ 10
      ≤ 1 / 6 * Real.exp (37 / 4200 * Real.log (49 / 100)) * Real.exp (-(37 / 2))
        * (1 - 37 / 2100) :=
