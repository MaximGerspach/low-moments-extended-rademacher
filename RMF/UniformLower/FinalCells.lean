/-! ### B2″: one cell; NH and F″ -/

/-- B2″, `q ∈ [9/20, ½)`, the main term (log-space bound `-20.70067`). -/
theorem finalB2MidMain : (-20.702 : ℝ) ≤ Real.log (1 / 2)
    + cellLogCore (9 / 20) (1 / 2) 0.17784 (9 / 20 * Real.log (9 / 20))
    - 9 / 20 * (1 - 2 * (9 / 20)) * 20.7867 - 1 / 2
    - 1 / 2 * Real.log (1 + 375 / 2 * (1 / 2)) := by
  unfold cellLogCore
  interval_decide (trust := kernel)

/-- B2″, the rest (log-slack `2.324`, certified `PhiB2Mid ≥ 10.215·10⁻¹⁰`). -/
theorem finalB2MidErr : 1 / 10 ^ 10 + Real.exp (-32) + Real.exp (cellLogErrMid (1 / 2) 945)
    ≤ Real.exp (-20.702) := by
  unfold cellLogErrMid
  interval_decide (trust := kernel)

/-- NH, Hölder near `½`: the numeral (margin `×3.924`). -/
theorem finalNH :
    (1 : ℝ) / 10 ^ 10 * Real.exp ((3 / 4 + 3 / 1400) * Real.log 6000) * Real.exp 18
      ≤ 18 * Real.exp (-(3 / 350 * Real.log 2)) := by
  interval_decide (trust := kernel)

/-- F″, the floor's numeral at `log log x ≥ 2100` (margin `×15.03`). -/
