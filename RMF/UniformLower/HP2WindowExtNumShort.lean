namespace RMF

/-- **HP2's certified constant on tubes of `r₀ ∈ [35, 2000)` blocks**: the value at the
largest rung `ρ ≤ r₀` (every `r₀ < 42` takes the rung `35`'s), written as the rung
`160`'s value plus the steps `Q(ρ) - Q(ρ')` of the rungs `ρ' > r₀`. -/
noncomputable def hp2QRung (r₀ : ℕ) : ℝ :=
  12959 + (if r₀ < 160 then 1680 else 0) + (if r₀ < 115 then 1481 else 0)
    + (if r₀ < 90 then 1541 else 0) + (if r₀ < 72 then 1417 else 0)
    + (if r₀ < 60 then 1617 else 0) + (if r₀ < 50 then 1751 else 0)
    + (if r₀ < 42 then 2096 else 0)

/-- One step of `RMF.hp2QRung` is nonincreasing. -/
lemma hp2QRung_step_anti {a b c : ℕ} {δ : ℝ} (hδ : 0 ≤ δ) (h : a ≤ b) :
    (if b < c then δ else 0) ≤ (if a < c then δ else 0) := by
  split_ifs <;> first | omega | linarith

/-- `RMF.hp2QRung` is a nonincreasing step function of the tube's length. -/
theorem hp2QRung_anti {a b : ℕ} (h : a ≤ b) : hp2QRung b ≤ hp2QRung a := by
  unfold hp2QRung
  have h0 := hp2QRung_step_anti (c := 160) (δ := 1680) (by norm_num) h
  have h1 := hp2QRung_step_anti (c := 115) (δ := 1481) (by norm_num) h
  have h2 := hp2QRung_step_anti (c := 90) (δ := 1541) (by norm_num) h
  have h3 := hp2QRung_step_anti (c := 72) (δ := 1417) (by norm_num) h
  have h4 := hp2QRung_step_anti (c := 60) (δ := 1617) (by norm_num) h
  have h5 := hp2QRung_step_anti (c := 50) (δ := 1751) (by norm_num) h
  have h6 := hp2QRung_step_anti (c := 42) (δ := 2096) (by norm_num) h
  linarith

