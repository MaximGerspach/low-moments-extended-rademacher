/-! ### The dispatcher -/

/-- **Every cell**: for `17 ≤ Λ ≤ 67.17`, a cell `[Λ₀, Λ₁] ∋ Λ` with its split point, its `b`
and its certificates. -/
theorem smallCells_spec {Λ : ℝ} (h17 : 17 ≤ Λ) (hΛ : Λ ≤ 67.17) :
    ∃ Λ₀ Λ₁ uF b : ℝ, 1 ≤ Λ₀ ∧ Λ₀ ≤ Λ ∧ Λ ≤ Λ₁ ∧ 8 ≤ Λ₁ ∧ 0 < uF ∧ 1 / 2 < b ∧ b ≤ 1
      ∧ 0 ≤ smallPhiF uF Λ₀ Λ₁ ∧ (uF * Λ₁ ≤ 17 ∨ 0 ≤ smallPhiI uF Λ₀ Λ₁ b) := by
  rcases le_or_gt Λ 40 with h0 | h0
  · exact smallCell_0 h17 h0
  rcases le_or_gt Λ 64 with h1 | h1
  · exact smallCell_1 h0.le h1
  rcases le_or_gt Λ 67 with h2 | h2
  · exact smallCell_2 h1.le h2
  exact smallCell_3 h2.le hΛ

end RMF
