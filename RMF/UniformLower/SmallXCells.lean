import LeanCert.Tactic.IntervalAuto

/-!
# Below `½` for small `x`: the certificates

For `17 ≤ Λ = log log x ≤ 67.17` and `u = 1 - 2q` with `uΛ > 17`, cells `[Λ₀, Λ₁]` of `Λ` with a
split point `u_F`: the floor F for `u ≥ u_F`, interpolation I at the cell's `b` for `u < u_F`
(`RMF/UniformLower/SmallXBounds.lean`).  In log space, `log F - log(2T)` and `log I - log(2T)`,
`T = 10⁻¹⁰min{Λ, 1/u}Λ^{-q/2}`, are at least `RMF.smallPhiF` and `RMF.smallPhiI` on the cell,
which are monotone in `u` with their minimum at `u_F` (`RMF/UniformLower/SmallXExplicit.lean`);
one certificate per bound and cell, by `interval_decide (trust := kernel)`, each a log-margin
beyond `×2`.  4 cells, 1 with F only (`u_F = 17/Λ₁`); the dispatcher
`RMF.smallCells_spec`.  Generated by a script.
-/

namespace RMF

/-! ### The log-space margins -/

/-- **F's log-margin over `2T` on a cell** at `u = 1 - 2q`, `q = (1-u)/2`:
`log(2^{-u}3^{-(1-q)}(0.23/L)^q) - log(2·10⁻¹⁰u⁻¹Λ₀^{-q/2})` with `log L = Λ ≤ Λ₁`. -/
noncomputable def smallPhiF (u Λ₀ Λ₁ : ℝ) : ℝ :=
  -(u * Real.log 2) - (1 + u) / 2 * Real.log 3 + (1 - u) / 2 * (Real.log (23 / 100) - Λ₁)
    - Real.log 2 + 10 * Real.log 10 + Real.log u + (1 - u) / 4 * Real.log Λ₀

/-- **I's log-margin over `2T` on a cell** at `u = 1 - 2q` and `b`, `δ = 2b - 1`:
`log((25L^{bδ}δ^{-3/4})^{-u/δ}) - log(2·10⁻¹⁰u⁻¹Λ₀^{-q/2})` with `log L = Λ ≤ Λ₁`. -/
noncomputable def smallPhiI (u Λ₀ Λ₁ b : ℝ) : ℝ :=
  -(u / (2 * b - 1) * (Real.log 25 - 3 / 4 * Real.log (2 * b - 1))) - u * b * Λ₁
    - Real.log 2 + 10 * Real.log 10 + Real.log u + (1 - u) / 4 * Real.log Λ₀

/-! ### Cell 0: `Λ ∈ [17, 40]`, F only -/

/-- Cell 0, F at `u = 0.425`: log-margin `8.88443` beyond `×2`. -/
theorem smallCellF_0 : (8.883 : ℝ) ≤ smallPhiF (0.425) 17 40 := by
  unfold smallPhiF
  interval_decide (trust := kernel)

/-- **Cell 0**, `Λ ∈ [17, 40]`: F only, `u_F = 17/40`. -/
theorem smallCell_0 {Λ : ℝ} (h0 : 17 ≤ Λ) (h1 : Λ ≤ 40) :
    ∃ Λ₀ Λ₁ uF b : ℝ, 1 ≤ Λ₀ ∧ Λ₀ ≤ Λ ∧ Λ ≤ Λ₁ ∧ 8 ≤ Λ₁ ∧ 0 < uF ∧ 1 / 2 < b ∧ b ≤ 1
      ∧ 0 ≤ smallPhiF uF Λ₀ Λ₁ ∧ (uF * Λ₁ ≤ 17 ∨ 0 ≤ smallPhiI uF Λ₀ Λ₁ b) :=
  ⟨17, 40, 0.425, 1, by norm_num, h0, h1, by norm_num, by norm_num, by norm_num,
    by norm_num, le_trans (by norm_num) smallCellF_0,
    Or.inl (by norm_num)⟩

/-! ### Cell 1: `Λ ∈ [40, 64]`, F and I -/

/-- Cell 1, F at `u = 0.38675`: log-margin `0.843814` beyond `×2`. -/
theorem smallCellF_1 : (0.843 : ℝ) ≤ smallPhiF (0.38675) 40 64 := by
  unfold smallPhiF
  interval_decide (trust := kernel)

/-- Cell 1, I at `u = 0.38675`, `b = 0.6915`: log-margin `0.85504` beyond `×2`. -/
theorem smallCellI_1 : (0.854 : ℝ) ≤ smallPhiI (0.38675) 40 64 0.6915 := by
  unfold smallPhiI
  interval_decide (trust := kernel)

/-- **Cell 1**, `Λ ∈ [40, 64]`: F for `u ≥ 0.38675`, I at `b = 0.6915` below. -/
theorem smallCell_1 {Λ : ℝ} (h0 : 40 ≤ Λ) (h1 : Λ ≤ 64) :
    ∃ Λ₀ Λ₁ uF b : ℝ, 1 ≤ Λ₀ ∧ Λ₀ ≤ Λ ∧ Λ ≤ Λ₁ ∧ 8 ≤ Λ₁ ∧ 0 < uF ∧ 1 / 2 < b ∧ b ≤ 1
      ∧ 0 ≤ smallPhiF uF Λ₀ Λ₁ ∧ (uF * Λ₁ ≤ 17 ∨ 0 ≤ smallPhiI uF Λ₀ Λ₁ b) :=
  ⟨40, 64, 0.38675, 0.6915, by norm_num, h0, h1, by norm_num, by norm_num, by norm_num,
    by norm_num, le_trans (by norm_num) smallCellF_1,
    Or.inr (le_trans (by norm_num) smallCellI_1)⟩

