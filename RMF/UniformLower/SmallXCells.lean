theorem smallCell_3 {Λ : ℝ} (h0 : 67 ≤ Λ) (h1 : Λ ≤ 67.17) :
    ∃ Λ₀ Λ₁ uF b : ℝ, 1 ≤ Λ₀ ∧ Λ₀ ≤ Λ ∧ Λ ≤ Λ₁ ∧ 8 ≤ Λ₁ ∧ 0 < uF ∧ 1 / 2 < b ∧ b ≤ 1
      ∧ 0 ≤ smallPhiF uF Λ₀ Λ₁ ∧ (uF * Λ₁ ≤ 17 ∨ 0 ≤ smallPhiI uF Λ₀ Λ₁ b) :=
