/-! ### Cell 3: `Λ ∈ [67, 67.17]`, F and I -/

/-- Cell 3, F at `u = 0.38825`: log-margin `0.00280357` beyond `×2`. -/
theorem smallCellF_3 : (0.002 : ℝ) ≤ smallPhiF (0.38825) 67 67.17 := by
  unfold smallPhiF
  interval_decide (trust := kernel)

