namespace RMF

/-! ### B2 and NH -/

/-- B2, `q ∈ [9/20, ½)`, `81 ≤ qΛ ≤ 1050`, the main term (log-space bound `-21.067437`). -/
theorem finalLowB2Main : (-21.068 : ℝ) ≤ Real.log (1 / 2)
    + cellLogCoreLow (9 / 20) (1 / 2) 0.17784 (9 / 20 * Real.log (9 / 20)) 1050 0.28667 24542
    - 9 / 20 * (1 - 2 * (9 / 20)) * 20.7867 - 1 / 2 := by
  unfold cellLogCoreLow
  interval_decide (trust := kernel)

/-- B2, the rest (log-slack `1.952`, certified `PhiB2Low ≥ 7.078·10⁻¹⁰`). -/
theorem finalLowB2Rest :
    1 / 10 ^ 10 + cellSubLow (9 / 20) (1 / 2) + cellErrLow (9 / 20) (1 / 2) 81 2100
      ≤ Real.exp (-21.068) := by
  unfold cellSubLow cellErrLow
  interval_decide (trust := kernel)

/-- **B2**: `PhiB2Low(q, Λ) ≥ 10⁻¹⁰` for `9/20 ≤ q < ½`, `Λ ≤ 2100` and `(1-2q)Λ ≥ 18`
(certified `×7.07`). -/
theorem PhiB2Low_ge {q Λ : ℝ} (hq0 : 9 / 20 ≤ q) (hq1 : q < 1 / 2) (hΛ : Λ ≤ 2100)
    (hu : 18 ≤ (1 - 2 * q) * Λ) : 1 / 10 ^ 10 ≤ PhiB2Low q Λ :=
  PhiB2Low_ge_of_cert finalLowB2Main finalLowB2Rest hq0 hq1 hΛ hu

/-- **NH, the numeral**: `10⁻¹⁰·2100^{3/4 + 67/1000}e^{18} ≤ 18·2^{-268/1000}` (margin `×4.39`). -/
theorem nh_num_low :
    (1 : ℝ) / 10 ^ 10 * Real.exp ((3 / 4 + 67 / 1000) * Real.log 2100) * Real.exp 18
      ≤ 18 * Real.exp (-(268 / 1000 * Real.log 2)) := by
  interval_decide (trust := kernel)

/-! ### The dispatcher -/

/-- **F or B1 on every cell**: `RMF.LowCellSpec q Λ` for `0 < q ≤ 9/20` and
`67.17 ≤ Λ ≤ 2100`. -/
theorem finalCellsLow_spec {q Λ : ℝ} (hq0 : 0 < q) (hq : q ≤ 9 / 20) (hΛ0 : 67.17 ≤ Λ)
    (hΛ1 : Λ ≤ 2100) : LowCellSpec q Λ := by
  rcases le_or_gt q (54 / 400) with h0 | h0
  · exact finalCellsLowQ0_spec hq0.le h0 hΛ0 hΛ1
  rcases le_or_gt q (68 / 400) with h1 | h1
  · exact finalCellsLowQ1_spec h0.le h1 hΛ0 hΛ1
  rcases le_or_gt q (81 / 400) with h2 | h2
  · exact finalCellsLowQ2_spec h1.le h2 hΛ0 hΛ1
  rcases le_or_gt q (100 / 400) with h3 | h3
  · exact finalCellsLowQ3_spec h2.le h3 hΛ0 hΛ1
  exact finalCellsLowQ4_spec h3.le (by linarith) hΛ0 hΛ1

