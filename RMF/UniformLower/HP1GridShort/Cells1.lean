/-!
# HP1's data on short tubes on the cells 10–19

Generated by a script.  For each cell
`ϑ ∈ [i/80, (i+1)/80]`, `10 ≤ i ≤ 19`: `RMF.hp1CellDataShort_i`, HP1's data from `k ≥ 20` on
tubes of `r ≥ 35` blocks at `RMF.hp1CellNumeralsShort_i`, from the cosine ranges
`RMF.hp1CellCos_i` by `RMF.hp1StartRanges_of_cos_short` and `RMF.hp1WindowHyps_of_cos_short`
at the block error `ε = 1.12·10⁻⁷`.  `RMF.hp1CellDataShort_part_1` collects them.
-/

open MeasureTheory

namespace RMF

variable {Ω : Type*} [MeasurableSpace Ω] {X : ℕ → Ω → ℂ} {μ : Measure Ω}

/-- **HP1's data on cell `10` on short tubes** (`ϑ ∈ [0.125, 0.1375]`, `k ≥ 20`, `r ≥ 35`), at
`RMF.hp1CellNumeralsShort_10`. -/
theorem hp1CellDataShort_10 (hX : IsRademacherPrimeValues X μ) {k r y : ℕ} {σ h : ℝ}
    (hk : 20 ≤ k) (hh : h ∈ hp1Cell k 10) (hσ : 0 ≤ σ)
    (hσr : σ * Real.exp ((k : ℝ) + r) ≤ 1 / 200)
    (hy : ∀ m, m < r → primeBlockSub k m ⊆ primesBelowSub y) (hr : 35 ≤ r) :
    HP1CellData X μ y k r σ h hp1CellNumeralsShort_10 := by
  obtain ⟨-, hξ₁, hξ₂⟩ := log_add_mem_of_mem_hp1Cell hh
  norm_num at hξ₁ hξ₂
  have hw := hp1Cell_subset_halfWindow (by norm_num) hh
