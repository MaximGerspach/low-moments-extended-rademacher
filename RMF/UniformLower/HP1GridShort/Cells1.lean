  exact ⟨hp1StartRanges_of_cos_short hX hk hw hσ hσr hy hr (ε := 1.12 / 10 ^ 7) (by norm_num)
      hc₀ hc₁ hC₀ hC₁
      (v0l := 0.16301) (v0h := 0.17577) (v1l := 0.6031) (v1h := 0.61875)
      (kl := (-0.27695)) (kh := (-0.22632)) (Sl := 1.99997) (Sh := 2.00003)
      (σl := 0.99998) (σh := 1.00002) (d0 := 0.40042) (Dl := (-1.55391)) (Dh := (-1.45263))
      (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
      (by norm_num),
    hp1WindowHyps_of_cos_short hX hk hw hσ hσr hy hr (ε := 1.12 / 10 ^ 7) (by norm_num)
      (ϑ₁ := (11 / 80)) (E := 1.1475) (by linarith) (by norm_num) (by norm_num) hE
      hc₀ hc₁ hc₂ hc₃ hC₀ hC₁ hC₂ hC₃
      (vmin := 0.47195) (vmax := 0.51959) (v2l := 0.471959888) (v3l := 0.480412888)
          (vt := 0.4877961021)
      (a := 3 / 2) (A := 5 / 2) (B := 3) (t := 0.9) (Λ := 0.062165) (BW := 1.15422)
