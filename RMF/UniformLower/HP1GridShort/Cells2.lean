/-!
# HP1's data on short tubes on the cells 20–29

Generated by a script.  For each cell
`ϑ ∈ [i/80, (i+1)/80]`, `20 ≤ i ≤ 29`: `RMF.hp1CellDataShort_i`, HP1's data from `k ≥ 20` on
tubes of `r ≥ 35` blocks at `RMF.hp1CellNumeralsShort_i`, from the cosine ranges
`RMF.hp1CellCos_i` by `RMF.hp1StartRanges_of_cos_short` and `RMF.hp1WindowHyps_of_cos_short`
at the block error `ε = 1.12·10⁻⁷`.  `RMF.hp1CellDataShort_part_2` collects them.
-/

open MeasureTheory

namespace RMF

variable {Ω : Type*} [MeasurableSpace Ω] {X : ℕ → Ω → ℂ} {μ : Measure Ω}

/-- **HP1's data on cell `20` on short tubes** (`ϑ ∈ [0.25, 0.2625]`, `k ≥ 20`, `r ≥ 35`), at
`RMF.hp1CellNumeralsShort_20`. -/
theorem hp1CellDataShort_20 (hX : IsRademacherPrimeValues X μ) {k r y : ℕ} {σ h : ℝ}
    (hk : 20 ≤ k) (hh : h ∈ hp1Cell k 20) (hσ : 0 ≤ σ)
    (hσr : σ * Real.exp ((k : ℝ) + r) ≤ 1 / 200)
    (hy : ∀ m, m < r → primeBlockSub k m ⊆ primesBelowSub y) (hr : 35 ≤ r) :
    HP1CellData X μ y k r σ h hp1CellNumeralsShort_20 := by
  obtain ⟨-, hξ₁, hξ₂⟩ := log_add_mem_of_mem_hp1Cell hh
  norm_num at hξ₁ hξ₂
  have hw := hp1Cell_subset_halfWindow (by norm_num) hh
  obtain ⟨hc₀, hc₁, hc₂, hc₃, hC₀, hC₁, hC₂, hC₃⟩ :=
    hp1CellCos_20 (ξ := Real.log h + k) (by linarith) (by linarith)
  have hE : Real.exp (21 / 80) ≤ 1.3002 := by interval_decide (trust := kernel)
  exact ⟨hp1StartRanges_of_cos_short hX hk hw hσ hσr hy hr (ε := 1.12 / 10 ^ 7) (by norm_num)
      hc₀ hc₁ hC₀ hC₁
      (v0l := 0.17319) (v0h := 0.18597) (v1l := 0.53657) (v1h := 0.55221)
      (kl := (-0.31181)) (kh := (-0.26117)) (Sl := 1.99997) (Sh := 2.00003)
      (σl := 0.99998) (σh := 1.00002) (d0 := 0.076) (Dl := (-1.62362)) (Dh := (-1.52234))
      (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
      (by norm_num),
    hp1WindowHyps_of_cos_short hX hk hw hσ hσr hy hr (ε := 1.12 / 10 ^ 7) (by norm_num)
      (ϑ₁ := (21 / 80)) (E := 1.3002) (by linarith) (by norm_num) (by norm_num) hE
      hc₀ hc₁ hc₂ hc₃ hC₀ hC₁ hC₂ hC₃
      (vmin := 0.4778) (vmax := 0.54205) (v2l := 0.526774888) (v3l := 0.477806888)
          (vt := 0.4868374807)
      (a := 3 / 2) (A := 5 / 2) (B := 3) (t := 0.9) (Λ := 0.22411) (BW := 1.10379)
      (n2 := 0) (n3 := 0.051885112) (b2 := 0.141855112) (b3 := 0.051885112) (σR2 := 0.008168)
      (Klate := 0.020875) (KR := 13.44633) (M₁ := 7) (K₂ := 10)
