      (kl := (-0.19781)) (kh := (-0.14718)) (Sl := 1.99997) (Sh := 2.00003)
      (σl := 0.99998) (σh := 1.00002) (d0 := 0.50343) (Dl := (-1.39563)) (Dh := (-1.29435))
      (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
      (by norm_num),
    hp1WindowHyps_of_cos_short hX hk hw hσ hσr hy hr (ε := 1.12 / 10 ^ 7) (by norm_num)
      (ϑ₁ := (41 / 80)) (E := 1.6695) (by linarith) (by norm_num) (by norm_num) hE
      hc₀ hc₁ hc₂ hc₃ hC₀ hC₁ hC₂ hC₃
      (vmin := 0.44321) (vmax := 0.5285) (v2l := 0.443214888) (v3l := 0.471504888)
          (vt := 0.4845190858)
      (a := 3 / 2) (A := 5 / 2) (B := 3) (t := 0.8) (Λ := 0.24269) (BW := 1.08386)
