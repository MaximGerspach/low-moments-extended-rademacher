/-!
# HP1's data on short tubes on the cells 40–49

Generated by a script.  For each cell
`ϑ ∈ [i/80, (i+1)/80]`, `40 ≤ i ≤ 49`: `RMF.hp1CellDataShort_i`, HP1's data from `k ≥ 20` on
tubes of `r ≥ 35` blocks at `RMF.hp1CellNumeralsShort_i`, from the cosine ranges
`RMF.hp1CellCos_i` by `RMF.hp1StartRanges_of_cos_short` and `RMF.hp1WindowHyps_of_cos_short`
at the block error `ε = 1.12·10⁻⁷`.  `RMF.hp1CellDataShort_part_4` collects them.
-/

open MeasureTheory

namespace RMF

variable {Ω : Type*} [MeasurableSpace Ω] {X : ℕ → Ω → ℂ} {μ : Measure Ω}

/-- **HP1's data on cell `40` on short tubes** (`ϑ ∈ [0.5, 0.5125]`, `k ≥ 20`, `r ≥ 35`), at
`RMF.hp1CellNumeralsShort_40`. -/
theorem hp1CellDataShort_40 (hX : IsRademacherPrimeValues X μ) {k r y : ℕ} {σ h : ℝ}
    (hk : 20 ≤ k) (hh : h ∈ hp1Cell k 40) (hσ : 0 ≤ σ)
    (hσr : σ * Real.exp ((k : ℝ) + r) ≤ 1 / 200)
    (hy : ∀ m, m < r → primeBlockSub k m ⊆ primesBelowSub y) (hr : 35 ≤ r) :
    HP1CellData X μ y k r σ h hp1CellNumeralsShort_40 := by
  obtain ⟨-, hξ₁, hξ₂⟩ := log_add_mem_of_mem_hp1Cell hh
  norm_num at hξ₁ hξ₂
  have hw := hp1Cell_subset_halfWindow (by norm_num) hh
  obtain ⟨hc₀, hc₁, hc₂, hc₃, hC₀, hC₁, hC₂, hC₃⟩ :=
    hp1CellCos_40 (ξ := Real.log h + k) (by linarith) (by linarith)
  have hE : Real.exp (41 / 80) ≤ 1.6695 := by interval_decide (trust := kernel)
  exact ⟨hp1StartRanges_of_cos_short hX hk hw hσ hσr hy hr (ε := 1.12 / 10 ^ 7) (by norm_num)
      hc₀ hc₁ hC₀ hC₁
