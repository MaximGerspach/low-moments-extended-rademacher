/-!
# HP1's data on short tubes on the cells 70–79

Generated by a script.  For each cell
`ϑ ∈ [i/80, (i+1)/80]`, `70 ≤ i ≤ 79`: `RMF.hp1CellDataShort_i`, HP1's data from `k ≥ 20` on
tubes of `r ≥ 35` blocks at `RMF.hp1CellNumeralsShort_i`, from the cosine ranges
`RMF.hp1CellCos_i` by `RMF.hp1StartRanges_of_cos_short` and `RMF.hp1WindowHyps_of_cos_short`
at the block error `ε = 1.12·10⁻⁷`.  `RMF.hp1CellDataShort_part_7` collects them.
-/

open MeasureTheory

namespace RMF

variable {Ω : Type*} [MeasurableSpace Ω] {X : ℕ → Ω → ℂ} {μ : Measure Ω}

/-- **HP1's data on cell `70` on short tubes** (`ϑ ∈ [0.875, 0.8875]`, `k ≥ 20`, `r ≥ 35`), at
`RMF.hp1CellNumeralsShort_70`. -/
theorem hp1CellDataShort_70 (hX : IsRademacherPrimeValues X μ) {k r y : ℕ} {σ h : ℝ}
    (hk : 20 ≤ k) (hh : h ∈ hp1Cell k 70) (hσ : 0 ≤ σ)
    (hσr : σ * Real.exp ((k : ℝ) + r) ≤ 1 / 200)
    (hy : ∀ m, m < r → primeBlockSub k m ⊆ primesBelowSub y) (hr : 35 ≤ r) :
    HP1CellData X μ y k r σ h hp1CellNumeralsShort_70 := by
  obtain ⟨-, hξ₁, hξ₂⟩ := log_add_mem_of_mem_hp1Cell hh
  norm_num at hξ₁ hξ₂
  have hw := hp1Cell_subset_halfWindow (by norm_num) hh
  obtain ⟨hc₀, hc₁, hc₂, hc₃, hC₀, hC₁, hC₂, hC₃⟩ :=
    hp1CellCos_70 (ξ := Real.log h + k) (by linarith) (by linarith)
  have hE : Real.exp (71 / 80) ≤ 2.4291 := by interval_decide (trust := kernel)
  exact ⟨hp1StartRanges_of_cos_short hX hk hw hσ hσr hy hr (ε := 1.12 / 10 ^ 7) (by norm_num)
      hc₀ hc₁ hC₀ hC₁
      (v0l := 0.56305) (v0h := 0.57583) (v1l := 0.28889) (v1h := 0.30167)
      (kl := 0.42093) (kh := 0.47157) (Sl := 1.99997) (Sh := 2.00003)
      (σl := 0.99998) (σh := 1.00002) (d0 := 1.00902) (Dl := (-0.15814)) (Dh := (-0.05686))
      (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
      (by norm_num),
    hp1WindowHyps_of_cos_short hX hk hw hσ hσr hy hr (ε := 1.12 / 10 ^ 7) (by norm_num)
      (ϑ₁ := (71 / 80)) (E := 2.4291) (by linarith) (by norm_num) (by norm_num) hE
      hc₀ hc₁ hc₂ hc₃ hC₀ hC₁ hC₂ hC₃
      (vmin := 0.47975) (vmax := 0.54065) (v2l := 0.493834888) (v3l := 0.525374888)
          (vt := 0.4797504621)
      (a := 3 / 2) (A := 5 / 2) (B := 3) (t := 0.9) (Λ := 0.067326) (BW := 1.29839)
      (n2 := 0.004635112) (n3 := 0.149185112) (b2 := 0.026405112) (b3 := 0.149185112)
          (σR2 := 0.051378)
      (Klate := 0.03853) (KR := 17.24328) (M₁ := 7) (K₂ := 10)
      (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
