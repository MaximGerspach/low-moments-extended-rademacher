/-- The factors `e^{2e^{1-d}}` of region II in numerals. -/
noncomputable def hp2WinE (d : ℕ) : ℝ := if d < 12 then hp2WinE2 d else 1.00004

/-- `e^{2e^{1-d}} ≤ hp2WinE d` for `4 ≤ d < 200`. -/
theorem hp2WinE_spec : ∀ d : ℕ, 4 ≤ d → d < 200 →
    Real.exp (2 * Real.exp (1 - (d : ℝ))) ≤ hp2WinE d := by
  intro d h₀ _
  unfold hp2WinE
  split_ifs with h
  · exact hp2WinE2_spec h₀ h
  · exact hp2WinE2_ge (by omega)

/-- The prefix bounds of region II in numerals: the pointwise bound below depth `12`, the slab
values from there. -/
noncomputable def hp2WinB (d j : ℕ) : ℝ :=
  if d < 12 then 20.08554 * max (hp2PostCh4 j) 1.05 ^ 2
  else hp2SlabPrefHat (max (hp2PostCh4 j) 1.05) * hp2WinG d

/-- `hp2PrefixBound d (max(c_h, 1.05)) ≤ hp2WinB d j` for `4 ≤ d < 200`. -/
theorem hp2WinB_spec : ∀ d, 4 ≤ d → d < 200 → ∀ j < 40,
    hp2PrefixBound d (max (hp2PostCh4 j) 1.05) ≤ hp2WinB d j := by
  intro d _ h₁ j _
  have hc : (0 : ℝ) ≤ max (hp2PostCh4 j) 1.05 := le_trans (by norm_num) (le_max_right _ _)
  unfold hp2WinB hp2PrefixBound
  split_ifs with h
  · exact (min_le_left _ _).trans (mul_le_mul_of_nonneg_right exp_three_le_numeral (sq_nonneg _))
  · exact (min_le_right _ _).trans (hp2WinG_spec (by omega) h₁ hc)

