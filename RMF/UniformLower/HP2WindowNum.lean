    h | h | h | h
  · exact hp2WinG_spec0 h₀ h hc
  · exact hp2WinG_spec1 h.1 h.2 hc
  · exact hp2WinG_spec2 h.1 h.2 hc
  · exact hp2WinG_spec3 h h₁ hc

/-- The slab values, summed. -/
theorem hp2WinG_sum : ∑ d ∈ Finset.Ico 12 200, hp2WinG d = 1.94677867 := by
  rw [← Finset.sum_Ico_consecutive _ (show 12 ≤ 59 by norm_num) (show 59 ≤ 200 by norm_num),
