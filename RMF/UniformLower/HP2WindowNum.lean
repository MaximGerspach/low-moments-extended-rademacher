/-- Region I's bounds `hp2WinP d j`, `d < 4`. -/
noncomputable def hp2WinP : ℕ → ℕ → ℝ
  | 0 => hp2WinP0
  | 1 => hp2WinP1
  | 2 => hp2WinP2
  | _ => hp2WinP3

/-- **Region I's cells in numerals**: `hp2WinIexpr d j·hp2Band(40d + j) ≤ hp2WinP d j`. -/
theorem hp2WinP_spec :
    ∀ d < 4, ∀ j < 40, hp2WinIexpr d j * hp2Band (40 * d + j) ≤ hp2WinP d j := by
  intro d hd j hj
  interval_cases d
  · exact hp2WinI0_spec hj
  · exact hp2WinI1_spec hj
  · exact hp2WinI2_spec hj
  · exact hp2WinI3_spec hj

/-- Region I's bounds, summed. -/
theorem hp2WinP_sum : ∑ d ∈ Finset.range 4, ∑ j ∈ Finset.range 40, hp2WinP d j = 768.061091 := by
  have h₀ : ∑ j ∈ Finset.range 40, hp2WinP 0 j = 5.540237 := hp2WinP0_sum
  have h₁ : ∑ j ∈ Finset.range 40, hp2WinP 1 j = 204.173191 := hp2WinP1_sum
  have h₂ : ∑ j ∈ Finset.range 40, hp2WinP 2 j = 209.20073 := hp2WinP2_sum
  have h₃ : ∑ j ∈ Finset.range 40, hp2WinP 3 j = 349.146933 := hp2WinP3_sum
  rw [Finset.sum_range_succ, Finset.sum_range_succ, Finset.sum_range_succ, Finset.sum_range_one,
    h₀, h₁, h₂, h₃]
  norm_num

/-- **The slab values**: `hp2SlabBound d c ≤ hp2SlabPrefHat c·hp2WinG d`, `12 ≤ d < 200`. -/
theorem hp2WinG_spec {d : ℕ} (h₀ : 12 ≤ d) (h₁ : d < 200) {c : ℝ} (hc : 0 ≤ c) :
    hp2SlabBound d c ≤ hp2SlabPrefHat c * hp2WinG d := by
