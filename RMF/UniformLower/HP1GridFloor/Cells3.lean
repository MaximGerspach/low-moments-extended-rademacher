/-!
# HP1's data at the floor `20` on the cells 30–39

Generated by a script.  For each cell
`ϑ ∈ [i/80, (i+1)/80]`, `30 ≤ i ≤ 39`: `RMF.hp1CellDataFloor_i`, HP1's data from `k ≥ 20` at
`RMF.hp1CellNumeralsFloor_i`, from the cosine ranges `RMF.hp1CellCos_i` (free of the floor) by
`RMF.hp1StartRanges_of_cos_floor` and `RMF.hp1WindowHyps_of_cos_floor` at the block error
`ε = 1.12·10⁻⁷`.  `RMF.hp1CellDataFloor_part_3` collects them.
-/

open MeasureTheory

namespace RMF

variable {Ω : Type*} [MeasurableSpace Ω] {X : ℕ → Ω → ℂ} {μ : Measure Ω}

/-- **HP1's data on cell `30` at the floor** (`ϑ ∈ [0.375, 0.3875]`, `k ≥ 20`), at
`RMF.hp1CellNumeralsFloor_30`. -/
theorem hp1CellDataFloor_30 (hX : IsRademacherPrimeValues X μ) {k r y : ℕ} {σ h : ℝ}
    (hk : 20 ≤ k) (hh : h ∈ hp1Cell k 30) (hσ : 0 ≤ σ)
    (hσr : σ * Real.exp ((k : ℝ) + r) ≤ 1 / 200)
    (hy : ∀ m, m < r → primeBlockSub k m ⊆ primesBelowSub y) (hr : 110 ≤ r) :
    HP1CellData X μ y k r σ h hp1CellNumeralsFloor_30 := by
  obtain ⟨-, hξ₁, hξ₂⟩ := log_add_mem_of_mem_hp1Cell hh
  norm_num at hξ₁ hξ₂
  have hw := hp1Cell_subset_halfWindow (by norm_num) hh
  obtain ⟨hc₀, hc₁, hc₂, hc₃, hC₀, hC₁, hC₂, hC₃⟩ :=
    hp1CellCos_30 (ξ := Real.log h + k) (by linarith) (by linarith)
  have hE : Real.exp (31 / 80) ≤ 1.4733 := by interval_decide (trust := kernel)
  exact ⟨hp1StartRanges_of_cos_floor hX hk hw hσ hσr hy hr (ε := 1.12 / 10 ^ 7) (by norm_num)
      hc₀ hc₁ hC₀ hC₁
      (v0l := 0.22273) (v0h := 0.23551) (v1l := 0.50834) (v1h := 0.52388)
      (kl := (-0.29398)) (kh := (-0.24334)) (Sl := 1.99997) (Sh := 2.00003)
      (σl := 0.99998) (σh := 1.00002) (d0 := 0.25997) (Dl := (-1.58796)) (Dh := (-1.48668))
      (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
      (by norm_num),
    hp1WindowHyps_of_cos_floor hX hk hw hσ hσr hy hr (ε := 1.12 / 10 ^ 7) (by norm_num)
      (ϑ₁ := (31 / 80)) (E := 1.4733) (by linarith) (by norm_num) (by norm_num) hE
      hc₀ hc₁ hc₂ hc₃ hC₀ hC₁ hC₂ hC₃
      (vmin := 0.47485) (vmax := 0.5475) (v2l := 0.532229888) (v3l := 0.474852888)
          (vt := 0.485750792)
      (a := 3 / 2) (A := 5 / 2) (B := 3) (t := 0.85) (Λ := 0.389548) (BW := 1.17944)
      (n2 := 0) (n3 := 0.089710112) (b2 := 0.266645112) (b3 := 0.089710112) (σR2 := 0.020208)
      (Klate := 0.023212) (KR := 21.66142) (M₁ := 7) (K₂ := 10)
      (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
      (by norm_num [max_def]) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
      (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
