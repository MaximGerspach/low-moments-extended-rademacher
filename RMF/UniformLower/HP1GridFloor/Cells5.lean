/-- **HP1's data at the floor on the cells 50–59** (`RMF.hp1CellDataFloor_50`, …,
`RMF.hp1CellDataFloor_59`). -/
theorem hp1CellDataFloor_part_5 (hX : IsRademacherPrimeValues X μ) {k r y i : ℕ} {σ h : ℝ}
    (hi₀ : 50 ≤ i) (hi : i ≤ 59) (hk : 20 ≤ k) (hh : h ∈ hp1Cell k i) (hσ : 0 ≤ σ)
    (hσr : σ * Real.exp ((k : ℝ) + r) ≤ 1 / 200)
    (hy : ∀ m, m < r → primeBlockSub k m ⊆ primesBelowSub y) (hr : 110 ≤ r) :
    HP1CellData X μ y k r σ h (hp1CellTableFloor i) := by
  interval_cases i
  · exact hp1CellDataFloor_50 hX hk hh hσ hσr hy hr
  · exact hp1CellDataFloor_51 hX hk hh hσ hσr hy hr
  · exact hp1CellDataFloor_52 hX hk hh hσ hσr hy hr
  · exact hp1CellDataFloor_53 hX hk hh hσ hσr hy hr
  · exact hp1CellDataFloor_54 hX hk hh hσ hσr hy hr
  · exact hp1CellDataFloor_55 hX hk hh hσ hσr hy hr
  · exact hp1CellDataFloor_56 hX hk hh hσ hσr hy hr
  · exact hp1CellDataFloor_57 hX hk hh hσ hσr hy hr
  · exact hp1CellDataFloor_58 hX hk hh hσ hσr hy hr
  · exact hp1CellDataFloor_59 hX hk hh hσ hσr hy hr

