import RMF.UniformLower.HP1Grid.DataFloor
import RMF.UniformLower.HP1Grid.Cells0

/-!
# HP1's data at the floor `20` on the cells 0–9

Generated by a script.  For each cell
`ϑ ∈ [i/80, (i+1)/80]`, `0 ≤ i ≤ 9`: `RMF.hp1CellDataFloor_i`, HP1's data from `k ≥ 20` at
`RMF.hp1CellNumeralsFloor_i`, from the cosine ranges `RMF.hp1CellCos_i` (free of the floor) by
`RMF.hp1StartRanges_of_cos_floor` and `RMF.hp1WindowHyps_of_cos_floor` at the block error
`ε = 1.12·10⁻⁷`.  `RMF.hp1CellDataFloor_part_0` collects them.
-/

open MeasureTheory

namespace RMF

variable {Ω : Type*} [MeasurableSpace Ω] {X : ℕ → Ω → ℂ} {μ : Measure Ω}

/-- **HP1's data on cell `0` at the floor** (`ϑ ∈ [0, 0.0125]`, `k ≥ 20`), at
`RMF.hp1CellNumeralsFloor_0`. -/
theorem hp1CellDataFloor_0 (hX : IsRademacherPrimeValues X μ) {k r y : ℕ} {σ h : ℝ}
    (hk : 20 ≤ k) (hh : h ∈ hp1Cell k 0) (hσ : 0 ≤ σ)
    (hσr : σ * Real.exp ((k : ℝ) + r) ≤ 1 / 200)
    (hy : ∀ m, m < r → primeBlockSub k m ⊆ primesBelowSub y) (hr : 110 ≤ r) :
    HP1CellData X μ y k r σ h hp1CellNumeralsFloor_0 := by
  obtain ⟨-, hξ₁, hξ₂⟩ := log_add_mem_of_mem_hp1Cell hh
  norm_num at hξ₁ hξ₂
  have hw := hp1Cell_subset_halfWindow (by norm_num) hh
  obtain ⟨hc₀, hc₁, hc₂, hc₃, hC₀, hC₁, hC₂, hC₃⟩ :=
    hp1CellCos_0 (ξ := Real.log h + k) (by linarith) (by linarith)
  have hE : Real.exp (1 / 80) ≤ 1.0126 := by interval_decide (trust := kernel)
  exact ⟨hp1StartRanges_of_cos_floor hX hk hw hσ hσr hy hr (ε := 1.12 / 10 ^ 7) (by norm_num)
      hc₀ hc₁ hC₀ hC₁
      (v0l := 0.20352) (v0h := 0.2163) (v1l := 0.59965) (v1h := 0.6153)
      (kl := (-0.25266)) (kh := (-0.20203)) (Sl := 1.99997) (Sh := 2.00003)
      (σl := 0.99998) (σh := 1.00002) (d0 := 0.75408) (Dl := (-1.50533)) (Dh := (-1.40405))
      (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
      (by norm_num),
    hp1WindowHyps_of_cos_floor hX hk hw hσ hσr hy hr (ε := 1.12 / 10 ^ 7) (by norm_num)
      (ϑ₁ := (1 / 80)) (E := 1.0126) (by linarith) (by norm_num) (by norm_num) hE
      hc₀ hc₁ hc₂ hc₃ hC₀ hC₁ hC₂ hC₃
      (vmin := 0.47245) (vmax := 0.51729) (v2l := 0.472457388) (v3l := 0.482714888)
          (vt := 0.4886429786)
      (a := 3 / 2) (A := 5 / 2) (B := 3) (t := 0.9) (Λ := 0.000771) (BW := 1.1566)
      (n2 := 0.078290112) (n3 := 0.071210112) (b2 := 0.078290112) (b3 := 0.071210112)
          (σR2 := 0.02501)
      (Klate := 0.016125) (KR := 11.27335) (M₁ := 7) (K₂ := 10)
      (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
      (by norm_num [max_def]) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
      (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
      (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)⟩

