/-- **HP1's data at the floor on the cells 60–69** (`RMF.hp1CellDataFloor_60`, …,
`RMF.hp1CellDataFloor_69`). -/
theorem hp1CellDataFloor_part_6 (hX : IsRademacherPrimeValues X μ) {k r y i : ℕ} {σ h : ℝ}
    (hi₀ : 60 ≤ i) (hi : i ≤ 69) (hk : 20 ≤ k) (hh : h ∈ hp1Cell k i) (hσ : 0 ≤ σ)
    (hσr : σ * Real.exp ((k : ℝ) + r) ≤ 1 / 200)
    (hy : ∀ m, m < r → primeBlockSub k m ⊆ primesBelowSub y) (hr : 110 ≤ r) :
    HP1CellData X μ y k r σ h (hp1CellTableFloor i) := by
  interval_cases i
  · exact hp1CellDataFloor_60 hX hk hh hσ hσr hy hr
  · exact hp1CellDataFloor_61 hX hk hh hσ hσr hy hr
  · exact hp1CellDataFloor_62 hX hk hh hσ hσr hy hr
  · exact hp1CellDataFloor_63 hX hk hh hσ hσr hy hr
  · exact hp1CellDataFloor_64 hX hk hh hσ hσr hy hr
  · exact hp1CellDataFloor_65 hX hk hh hσ hσr hy hr
  · exact hp1CellDataFloor_66 hX hk hh hσ hσr hy hr
  · exact hp1CellDataFloor_67 hX hk hh hσ hσr hy hr
  · exact hp1CellDataFloor_68 hX hk hh hσ hσr hy hr
