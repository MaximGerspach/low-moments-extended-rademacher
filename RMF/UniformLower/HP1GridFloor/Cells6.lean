/-!
# HP1's data at the floor `20` on the cells 60–69

Generated by a script.  For each cell
`ϑ ∈ [i/80, (i+1)/80]`, `60 ≤ i ≤ 69`: `RMF.hp1CellDataFloor_i`, HP1's data from `k ≥ 20` at
`RMF.hp1CellNumeralsFloor_i`, from the cosine ranges `RMF.hp1CellCos_i` (free of the floor) by
`RMF.hp1StartRanges_of_cos_floor` and `RMF.hp1WindowHyps_of_cos_floor` at the block error
`ε = 1.12·10⁻⁷`.  `RMF.hp1CellDataFloor_part_6` collects them.
-/

open MeasureTheory

namespace RMF

variable {Ω : Type*} [MeasurableSpace Ω] {X : ℕ → Ω → ℂ} {μ : Measure Ω}

/-- **HP1's data on cell `60` at the floor** (`ϑ ∈ [0.75, 0.7625]`, `k ≥ 20`), at
`RMF.hp1CellNumeralsFloor_60`. -/
theorem hp1CellDataFloor_60 (hX : IsRademacherPrimeValues X μ) {k r y : ℕ} {σ h : ℝ}
    (hk : 20 ≤ k) (hh : h ∈ hp1Cell k 60) (hσ : 0 ≤ σ)
    (hσr : σ * Real.exp ((k : ℝ) + r) ≤ 1 / 200)
    (hy : ∀ m, m < r → primeBlockSub k m ⊆ primesBelowSub y) (hr : 110 ≤ r) :
    HP1CellData X μ y k r σ h hp1CellNumeralsFloor_60 := by
  obtain ⟨-, hξ₁, hξ₂⟩ := log_add_mem_of_mem_hp1Cell hh
  norm_num at hξ₁ hξ₂
  have hw := hp1Cell_subset_halfWindow (by norm_num) hh
  obtain ⟨hc₀, hc₁, hc₂, hc₃, hC₀, hC₁, hC₂, hC₃⟩ :=
    hp1CellCos_60 (ξ := Real.log h + k) (by linarith) (by linarith)
  have hE : Real.exp (61 / 80) ≤ 2.1437 := by interval_decide (trust := kernel)
  exact ⟨hp1StartRanges_of_cos_floor hX hk hw hσ hσr hy hr (ε := 1.12 / 10 ^ 7) (by norm_num)
      hc₀ hc₁ hC₀ hC₁
      (v0l := 0.47746) (v0h := 0.49024) (v1l := 0.39383) (v1h := 0.40661)
      (kl := 0.18469) (kh := 0.23532) (Sl := 1.99997) (Sh := 2.00003)
      (σl := 0.99998) (σh := 1.00002) (d0 := 0.87361) (Dl := (-0.63063)) (Dh := (-0.52935))
      (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
      (by norm_num),
    hp1WindowHyps_of_cos_floor hX hk hw hσ hσr hy hr (ε := 1.12 / 10 ^ 7) (by norm_num)
      (ϑ₁ := (61 / 80)) (E := 2.1437) (by linarith) (by norm_num) (by norm_num) hE
      hc₀ hc₁ hc₂ hc₃ hC₀ hC₁ hC₂ hC₃
      (vmin := 0.45594) (vmax := 0.51734) (v2l := 0.455944888) (v3l := 0.502069888)
          (vt := 0.4815421488)
      (a := 3 / 2) (A := 5 / 2) (B := 3) (t := 0.8) (Λ := 0.006131) (BW := 1.10768)
      (n2 := 0) (n3 := 0.008265112) (b2 := 0.049705112) (b3 := 0.022045112) (σR2 := 0.007098)
      (Klate := 0.033678) (KR := 10.61969) (M₁ := 7) (K₂ := 10)
      (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
      (by norm_num [max_def]) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
