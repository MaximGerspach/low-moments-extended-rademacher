theorem hp2WinE2_ge {d : ℕ} (h : 12 ≤ d) :
    Real.exp (2 * Real.exp (1 - (d : ℝ))) ≤ 1.00004 := by
  have hd : (12 : ℝ) ≤ d := by exact_mod_cast h
  have h12 : Real.exp (2 * Real.exp (1 - 12)) ≤ 1.00004 := by
    interval_decide (trust := kernel)
  refine le_trans (Real.exp_le_exp.2 ?_) h12
  have := Real.exp_le_exp.2 (show 1 - (d : ℝ) ≤ 1 - 12 by linarith)
  linarith

