theorem hp2WinI0_spec {j : ℕ} (hj : j < 40) :
    hp2WinIexpr 0 j * hp2Band (40 * 0 + j) ≤ hp2WinP0 j := by
  rcases (by omega : j < 18 ∨ j = 18 ∨ 19 ≤ j) with h | h | h
  · rw [hp2Band_eq_zero (i := 40 * 0 + j) (hp2CellEnd_eighteen_nineteen.2.trans
      (hp2CellEnd_anti (by omega))), mul_zero]
    interval_cases j <;> norm_num [hp2WinP0]
  · subst h
    rw [hp2Band_eq_sq (i := 40 * 0 + 18) hp2CellEnd_eighteen_nineteen.2
      hp2CellEnd_eighteen_nineteen.1]
    exact hp2WinI_0_18
  · rw [hp2Band_eq_prod (i := 40 * 0 + j) (hp2CellEnd_le_of_ge (by omega))]
