    -0.487121 ≤ blockCos (21 / 80) 0 ∧ blockCos (21 / 80) 0 ≤ -0.486809 := by
  have h := abs_blockCos_zero_sub_anti_le (c := (21 / 80)) (d := (101 / 80))
    (by norm_num) (by norm_num)
  have e1 : (-0.48712 : ℝ) ≤ cosExpAnti (101 / 80) - cosExpAnti (21 / 80) := by
    simp only [cosExpAnti_eq_horner]
    interval_decide (trust := kernel)
  have e2 : cosExpAnti (101 / 80) - cosExpAnti (21 / 80) ≤ (-0.48681 : ℝ) := by
    simp only [cosExpAnti_eq_horner]
    interval_decide (trust := kernel)
  rw [abs_le] at h
  constructor <;> linarith [h.1, h.2]

