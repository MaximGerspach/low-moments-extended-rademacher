theorem blockCos_zero_dense_81 :
    -0.141771 ≤ blockCos (1 / 80) 0 ∧ blockCos (1 / 80) 0 ≤ -0.141459 := by
  have h := abs_blockCos_zero_sub_anti_le (c := (1 / 80)) (d := (81 / 80))
    (by norm_num) (by norm_num)
  have e1 : (-0.14177 : ℝ) ≤ cosExpAnti (81 / 80) - cosExpAnti (1 / 80) := by
    simp only [cosExpAnti_eq_horner]
    interval_decide (trust := kernel)
  have e2 : cosExpAnti (81 / 80) - cosExpAnti (1 / 80) ≤ (-0.14146 : ℝ) := by
    simp only [cosExpAnti_eq_horner]
    interval_decide (trust := kernel)
  rw [abs_le] at h
  constructor <;> linarith [h.1, h.2]

