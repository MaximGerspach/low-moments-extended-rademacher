theorem blockCos_zero_dense_181 :
    0.03015 ≤ blockCos (101 / 80) 0 ∧ blockCos (101 / 80) 0 ≤ 0.03619 := by
  have h := abs_blockCos_zero_sub_mixed_le (c := (101 / 80)) (d := (181 / 80))
    (by norm_num) (by norm_num) (by norm_num)
  have hK := cosExpAnti_two_cosExpTail_two_mem
  have s1 : (-0.61856 : ℝ) ≤ cosExpAnti (101 / 80) := by
    simp only [cosExpAnti_eq_horner]
    interval_decide (trust := kernel)
  have s2 : cosExpAnti (101 / 80) ≤ (-0.61825 : ℝ) := by
    simp only [cosExpAnti_eq_horner]
    interval_decide (trust := kernel)
  have p1 : (-0.00865 : ℝ) ≤ cosExpTail (181 / 80) := by
    rw [cosExpTail_eq_turn_odd (181 / 80) 3 1 (by norm_num)]
    interval_decide (trust := kernel)
