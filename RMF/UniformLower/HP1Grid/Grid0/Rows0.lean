/-- `blockCos (-1) 0 ∈ [0.793679, 0.793991]`, from `RMF.cosExpAnti`. -/
theorem blockCos_zero_dense_0 :
    0.793679 ≤ blockCos (-1) 0 ∧ blockCos (-1) 0 ≤ 0.793991 := by
  have h := abs_blockCos_zero_sub_anti_le (c := (-1)) (d := 0)
    (by norm_num) (by norm_num)
  have e1 : (0.79368 : ℝ) ≤ cosExpAnti 0 - cosExpAnti (-1) := by
    simp only [cosExpAnti_eq_horner]
    interval_decide (trust := kernel)
  have e2 : cosExpAnti 0 - cosExpAnti (-1) ≤ (0.79399 : ℝ) := by
    simp only [cosExpAnti_eq_horner]
    interval_decide (trust := kernel)
  rw [abs_le] at h
  constructor <;> linarith [h.1, h.2]

