/-- `blockCos (-39 / 80) 0 ∈ [0.471989, 0.472301]`, from `RMF.cosExpAnti`. -/
theorem blockCos_zero_dense_41 :
    0.471989 ≤ blockCos (-39 / 80) 0 ∧ blockCos (-39 / 80) 0 ≤ 0.472301 := by
  have h := abs_blockCos_zero_sub_anti_le (c := (-39 / 80)) (d := (41 / 80))
    (by norm_num) (by norm_num)
  have e1 : (0.47199 : ℝ) ≤ cosExpAnti (41 / 80) - cosExpAnti (-39 / 80) := by
    simp only [cosExpAnti_eq_horner]
    interval_decide (trust := kernel)
  have e2 : cosExpAnti (41 / 80) - cosExpAnti (-39 / 80) ≤ (0.4723 : ℝ) := by
    simp only [cosExpAnti_eq_horner]
    interval_decide (trust := kernel)
  rw [abs_le] at h
  constructor <;> linarith [h.1, h.2]

