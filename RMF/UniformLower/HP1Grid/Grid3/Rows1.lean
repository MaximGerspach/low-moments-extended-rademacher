    0.03679 ≤ blockCos (181 / 80) 0 ∧ blockCos (181 / 80) 0 ≤ 0.0421 := by
  have h := abs_blockCos_zero_sub_tail_le (c := (181 / 80)) (d := (261 / 80))
    (by norm_num) (by norm_num)
  have e1 : (0.03929 : ℝ) ≤ cosExpTail (261 / 80) - cosExpTail (181 / 80) := by
    rw [cosExpTail_eq_turn_even (261 / 80) 8 4 (by norm_num),
      cosExpTail_eq_turn_odd (181 / 80) 3 1 (by norm_num)]
    interval_decide (trust := kernel)
  have e2 : cosExpTail (261 / 80) - cosExpTail (181 / 80) ≤ (0.0396 : ℝ) := by
    rw [cosExpTail_eq_turn_even (261 / 80) 8 4 (by norm_num),
      cosExpTail_eq_turn_odd (181 / 80) 3 1 (by norm_num)]
    interval_decide (trust := kernel)
  rw [abs_le] at h
  constructor <;> linarith [h.1, h.2]

