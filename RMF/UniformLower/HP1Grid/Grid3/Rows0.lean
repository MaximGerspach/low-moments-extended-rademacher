/-- `blockCos (161 / 80) 0 ∈ [-0.06835, -0.06304]`, from `RMF.cosExpTail`. -/
theorem blockCos_zero_dense_241 :
    -0.06835 ≤ blockCos (161 / 80) 0 ∧ blockCos (161 / 80) 0 ≤ -0.06304 := by
  have h := abs_blockCos_zero_sub_tail_le (c := (161 / 80)) (d := (241 / 80))
    (by norm_num) (by norm_num)
  have e1 : (-0.06585 : ℝ) ≤ cosExpTail (241 / 80) - cosExpTail (161 / 80) := by
    rw [cosExpTail_eq_turn_even (241 / 80) 6 3 (by norm_num),
      cosExpTail_eq_turn_even (161 / 80) 2 1 (by norm_num)]
    interval_decide (trust := kernel)
  have e2 : cosExpTail (241 / 80) - cosExpTail (161 / 80) ≤ (-0.06554 : ℝ) := by
    rw [cosExpTail_eq_turn_even (241 / 80) 6 3 (by norm_num),
      cosExpTail_eq_turn_even (161 / 80) 2 1 (by norm_num)]
    interval_decide (trust := kernel)
  rw [abs_le] at h
  constructor <;> linarith [h.1, h.2]

