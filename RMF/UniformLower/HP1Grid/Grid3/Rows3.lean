/-- `blockCos (221 / 80) 0 ∈ [-0.01717, -0.01186]`, from `RMF.cosExpTail`. -/
theorem blockCos_zero_dense_301 :
    -0.01717 ≤ blockCos (221 / 80) 0 ∧ blockCos (221 / 80) 0 ≤ -0.01186 := by
  have h := abs_blockCos_zero_sub_tail_le (c := (221 / 80)) (d := (301 / 80))
    (by norm_num) (by norm_num)
  have e1 : (-0.01467 : ℝ) ≤ cosExpTail (301 / 80) - cosExpTail (221 / 80) := by
    rw [cosExpTail_eq_turn_three_half (301 / 80) (27 / 2) 6 (by norm_num),
      cosExpTail_eq_turn_odd (221 / 80) 5 2 (by norm_num)]
    interval_decide (trust := kernel)
  have e2 : cosExpTail (301 / 80) - cosExpTail (221 / 80) ≤ (-0.01436 : ℝ) := by
    rw [cosExpTail_eq_turn_three_half (301 / 80) (27 / 2) 6 (by norm_num),
      cosExpTail_eq_turn_odd (221 / 80) 5 2 (by norm_num)]
    interval_decide (trust := kernel)
  rw [abs_le] at h
  constructor <;> linarith [h.1, h.2]

