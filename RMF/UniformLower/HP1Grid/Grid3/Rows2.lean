/-- `blockCos (201 / 80) 0 ∈ [0.04769, 0.053]`, from `RMF.cosExpTail`. -/
theorem blockCos_zero_dense_281 :
    0.04769 ≤ blockCos (201 / 80) 0 ∧ blockCos (201 / 80) 0 ≤ 0.053 := by
  have h := abs_blockCos_zero_sub_tail_le (c := (201 / 80)) (d := (281 / 80))
    (by norm_num) (by norm_num)
  have e1 : (0.05019 : ℝ) ≤ cosExpTail (281 / 80) - cosExpTail (201 / 80) := by
    rw [cosExpTail_eq_turn_half (281 / 80) (21 / 2) 5 (by norm_num),
      cosExpTail_eq_turn_three_half (201 / 80) (7 / 2) 1 (by norm_num)]
    interval_decide (trust := kernel)
  have e2 : cosExpTail (281 / 80) - cosExpTail (201 / 80) ≤ (0.0505 : ℝ) := by
    rw [cosExpTail_eq_turn_half (281 / 80) (21 / 2) 5 (by norm_num),
      cosExpTail_eq_turn_three_half (201 / 80) (7 / 2) 1 (by norm_num)]
    interval_decide (trust := kernel)
  rw [abs_le] at h
  constructor <;> linarith [h.1, h.2]

