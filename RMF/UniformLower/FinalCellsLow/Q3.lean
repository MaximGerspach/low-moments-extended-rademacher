import RMF.UniformLower.FinalCellsLow.Q3.Part0
import RMF.UniformLower.FinalCellsLow.Q3.Part1
import RMF.UniformLower.FinalCellsLow.Q3.Part2
import RMF.UniformLower.FinalCellsLow.Q3.Part3

/-!
# The low range's certificates, shard 3: `q ∈ [81 / 400, 100 / 400]`

Generated by a script.

For `67.17 ≤ Λ ≤ 2100`: the q-cells 25–31 (7 F cells, 16 B1 cells), certified against the
cell bounds of `RMF/UniformLower/FinalNumeralsLow.lean` by `interval_decide (trust := kernel)`: per
q-cell `c₃ ≥ c` on its grid steps (`finalLowC3_i`) and F (`finalLowF_i`); per B1 cell
the main term, the rest and the rung (`finalLowMain_i_j`, `finalLowRest_i_j`,
`finalLowRung_i_j`); per q-cell `RMF.LowCellSpec` (`finalLowQCell_i`), and the dispatch
`RMF.finalCellsLowQ3_spec`.

Its cells are in `RMF/UniformLower/FinalCellsLow/Q3/`, 2 sections to a file.
-/

namespace RMF

/-! ### Shard 3: the dispatch -/

/-- **Shard 3**, `q ∈ [81 / 400, 100 / 400]`: the q-cell of `q`. -/
theorem finalCellsLowQ3_spec {q Λ : ℝ} (ha : 81 / 400 ≤ q) (hb : q ≤ 100 / 400) (hΛ0 : 67.17 ≤ Λ)
    (hΛ1 : Λ ≤ 2100) : LowCellSpec q Λ := by
  rcases le_or_gt q (83 / 400) with h0 | h0
  · exact finalLowQCell_25 ha h0 hΛ0 hΛ1
  rcases le_or_gt q (85 / 400) with h1 | h1
  · exact finalLowQCell_26 h0.le h1 hΛ0 hΛ1
  rcases le_or_gt q (88 / 400) with h2 | h2
  · exact finalLowQCell_27 h1.le h2 hΛ0 hΛ1
  rcases le_or_gt q (90 / 400) with h3 | h3
  · exact finalLowQCell_28 h2.le h3 hΛ0 hΛ1
  rcases le_or_gt q (93 / 400) with h4 | h4
  · exact finalLowQCell_29 h3.le h4 hΛ0 hΛ1
  rcases le_or_gt q (97 / 400) with h5 | h5
  · exact finalLowQCell_30 h4.le h5 hΛ0 hΛ1
  exact finalLowQCell_31 h5.le hb hΛ0 hΛ1

end RMF
