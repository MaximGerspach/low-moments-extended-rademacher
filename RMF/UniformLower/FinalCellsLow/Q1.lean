import RMF.UniformLower.FinalCellsLow.Q1.Part0
import RMF.UniformLower.FinalCellsLow.Q1.Part1
import RMF.UniformLower.FinalCellsLow.Q1.Part2
import RMF.UniformLower.FinalCellsLow.Q1.Part3

/-!
# The low range's certificates, shard 1: `q ∈ [54 / 400, 68 / 400]`

Generated by a script.

For `67.17 ≤ Λ ≤ 2100`: the q-cells 9–16 (8 F cells, 16 B1 cells), certified against the
cell bounds of `RMF/UniformLower/FinalNumeralsLow.lean` by `interval_decide (trust := kernel)`: per
q-cell `c₃ ≥ c` on its grid steps (`finalLowC3_i`) and F (`finalLowF_i`); per B1 cell
the main term, the rest and the rung (`finalLowMain_i_j`, `finalLowRest_i_j`,
`finalLowRung_i_j`); per q-cell `RMF.LowCellSpec` (`finalLowQCell_i`), and the dispatch
`RMF.finalCellsLowQ1_spec`.

Its cells are in `RMF/UniformLower/FinalCellsLow/Q1/`, 2 sections to a file.
-/

namespace RMF

/-! ### Shard 1: the dispatch -/

/-- **Shard 1**, `q ∈ [54 / 400, 68 / 400]`: the q-cell of `q`. -/
theorem finalCellsLowQ1_spec {q Λ : ℝ} (ha : 54 / 400 ≤ q) (hb : q ≤ 68 / 400) (hΛ0 : 67.17 ≤ Λ)
    (hΛ1 : Λ ≤ 2100) : LowCellSpec q Λ := by
  rcases le_or_gt q (56 / 400) with h0 | h0
  · exact finalLowQCell_9 ha h0 hΛ0 hΛ1
  rcases le_or_gt q (58 / 400) with h1 | h1
  · exact finalLowQCell_10 h0.le h1 hΛ0 hΛ1
  rcases le_or_gt q (60 / 400) with h2 | h2
  · exact finalLowQCell_11 h1.le h2 hΛ0 hΛ1
  rcases le_or_gt q (62 / 400) with h3 | h3
  · exact finalLowQCell_12 h2.le h3 hΛ0 hΛ1
  rcases le_or_gt q (64 / 400) with h4 | h4
  · exact finalLowQCell_13 h3.le h4 hΛ0 hΛ1
  rcases le_or_gt q (66 / 400) with h5 | h5
  · exact finalLowQCell_14 h4.le h5 hΛ0 hΛ1
  rcases le_or_gt q (67 / 400) with h6 | h6
  · exact finalLowQCell_15 h5.le h6 hΛ0 hΛ1
  exact finalLowQCell_16 h6.le hb hΛ0 hΛ1

end RMF
