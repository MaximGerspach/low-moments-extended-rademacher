import RMF.UniformLower.FinalCellsLow.Q4.Part0
import RMF.UniformLower.FinalCellsLow.Q4.Part1
import RMF.UniformLower.FinalCellsLow.Q4.Part2
import RMF.UniformLower.FinalCellsLow.Q4.Part3

/-!
# The low range's certificates, shard 4: `q ∈ [100 / 400, 180 / 400]`

Generated by a script.

For `67.17 ≤ Λ ≤ 2100`: the q-cells 32–38 (4 F cells, 14 B1 cells), certified against the
cell bounds of `RMF/UniformLower/FinalNumeralsLow.lean` by `interval_decide (trust := kernel)`: per
q-cell `c₃ ≥ c` on its grid steps (`finalLowC3_i`) and F (`finalLowF_i`); per B1 cell
the main term, the rest and the rung (`finalLowMain_i_j`, `finalLowRest_i_j`,
`finalLowRung_i_j`); per q-cell `RMF.LowCellSpec` (`finalLowQCell_i`), and the dispatch
`RMF.finalCellsLowQ4_spec`.

Its cells are in `RMF/UniformLower/FinalCellsLow/Q4/`, 2 sections to a file.
-/

namespace RMF

/-! ### Shard 4: the dispatch -/

/-- **Shard 4**, `q ∈ [100 / 400, 180 / 400]`: the q-cell of `q`. -/
theorem finalCellsLowQ4_spec {q Λ : ℝ} (ha : 100 / 400 ≤ q) (hb : q ≤ 180 / 400) (hΛ0 : 67.17 ≤ Λ)
    (hΛ1 : Λ ≤ 2100) : LowCellSpec q Λ := by
  rcases le_or_gt q (104 / 400) with h0 | h0
  · exact finalLowQCell_32 ha h0 hΛ0 hΛ1
  rcases le_or_gt q (109 / 400) with h1 | h1
  · exact finalLowQCell_33 h0.le h1 hΛ0 hΛ1
  rcases le_or_gt q (115 / 400) with h2 | h2
  · exact finalLowQCell_34 h1.le h2 hΛ0 hΛ1
  rcases le_or_gt q (123 / 400) with h3 | h3
  · exact finalLowQCell_35 h2.le h3 hΛ0 hΛ1
  rcases le_or_gt q (139 / 400) with h4 | h4
  · exact finalLowQCell_36 h3.le h4 hΛ0 hΛ1
  rcases le_or_gt q (170 / 400) with h5 | h5
  · exact finalLowQCell_37 h4.le h5 hΛ0 hΛ1
  exact finalLowQCell_38 h5.le hb hΛ0 hΛ1

end RMF
