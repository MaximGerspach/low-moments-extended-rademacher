import RMF.UniformLower.FinalCellsLow.Q0.Part0
import RMF.UniformLower.FinalCellsLow.Q0.Part1
import RMF.UniformLower.FinalCellsLow.Q0.Part2
import RMF.UniformLower.FinalCellsLow.Q0.Part3
import RMF.UniformLower.FinalCellsLow.Q0.Part4

/-!
# The low range's certificates, shard 0: `q ∈ [0, 54 / 400]`

Generated by a script.

For `67.17 ≤ Λ ≤ 2100`: the q-cells 0–8 (9 F cells, 15 B1 cells), certified against the
cell bounds of `RMF/UniformLower/FinalNumeralsLow.lean` by `interval_decide (trust := kernel)`: per
q-cell `c₃ ≥ c` on its grid steps (`finalLowC3_i`) and F (`finalLowF_i`); per B1 cell
the main term, the rest and the rung (`finalLowMain_i_j`, `finalLowRest_i_j`,
`finalLowRung_i_j`); per q-cell `RMF.LowCellSpec` (`finalLowQCell_i`), and the dispatch
`RMF.finalCellsLowQ0_spec`.

Its cells are in `RMF/UniformLower/FinalCellsLow/Q0/`, 2 sections to a file.
-/

namespace RMF

/-! ### Shard 0: the dispatch -/

/-- **Shard 0**, `q ∈ [0, 54 / 400]`: the q-cell of `q`. -/
theorem finalCellsLowQ0_spec {q Λ : ℝ} (ha : 0 ≤ q) (hb : q ≤ 54 / 400) (hΛ0 : 67.17 ≤ Λ)
    (hΛ1 : Λ ≤ 2100) : LowCellSpec q Λ := by
  rcases le_or_gt q (1 / 105) with h0 | h0
  · exact finalLowQCell_0 ha h0 hΛ0 hΛ1
  rcases le_or_gt q (14 / 400) with h1 | h1
  · exact finalLowQCell_1 h0.le h1 hΛ0 hΛ1
  rcases le_or_gt q (23 / 400) with h2 | h2
  · exact finalLowQCell_2 h1.le h2 hΛ0 hΛ1
  rcases le_or_gt q (30 / 400) with h3 | h3
  · exact finalLowQCell_3 h2.le h3 hΛ0 hΛ1
  rcases le_or_gt q (37 / 400) with h4 | h4
  · exact finalLowQCell_4 h3.le h4 hΛ0 hΛ1
  rcases le_or_gt q (42 / 400) with h5 | h5
  · exact finalLowQCell_5 h4.le h5 hΛ0 hΛ1
  rcases le_or_gt q (46 / 400) with h6 | h6
  · exact finalLowQCell_6 h5.le h6 hΛ0 hΛ1
  rcases le_or_gt q (50 / 400) with h7 | h7
  · exact finalLowQCell_7 h6.le h7 hΛ0 hΛ1
  exact finalLowQCell_8 h7.le hb hΛ0 hΛ1

end RMF
