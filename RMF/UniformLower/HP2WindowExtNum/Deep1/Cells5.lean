import RMF.UniformLower.HP2WindowExt.Cells

/-!
# Numerals for HP2's window integral with the rest: the deep cells `75 ≤ j < 80`

Generated by a script.

Per cell the bound on the rest's damped cosine integral (`RMF.IsRestCosBound`) and the
weight `e^{2B_j + 10⁻¹⁹ - j/40} ≤ w_j`; `RMF/UniformLower/HP2WindowExtNum/Deep1.lean`
collects them.
-/

namespace RMF

attribute [local simp] LeanCert.Core.MathConst.toReal

theorem hp2ExtB_num_75 :
    Real.log (Real.pi * (1 / 2)) - (1 / 10)
      - (Real.pi * Real.pi * (1 / 4) - Real.exp (2 * (1 / 10))) * (1 / 4)
      + (Real.pi * Real.pi * Real.pi * Real.pi * (1 / 16) - Real.exp (4 * (1 / 10)))
        * (1 / 96)
      - Real.exp (-1 - (1 / 10)) * (1 / 100) * (1 - Real.sin (Real.exp (1 / 10)))
      + Real.exp (-2 - 2 * (1 / 10)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (1 / 10) * Real.sin (Real.exp (1 / 10))
          - Real.cos (Real.exp (1 / 10))) ≤ 0.0878 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_75 : IsRestCosBound (hp2DeepEnd 76) (hp2DeepEnd 75) 0.0878 := by
  rw [hp2DeepEnd_eq_exp 76 (ℓ := 1 / 10) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_75

theorem hp2ExtW_75 :
    Real.exp (2 * 0.0878 + 1 / 10 ^ 19 - ((75 : ℕ) : ℝ) / 40) ≤ 0.182797 := by
  simp only [Nat.cast_ofNat]
  interval_decide (trust := kernel)

