import RMF.UniformLower.HP2WindowExt.Cells

/-!
# Numerals for HP2's window integral with the rest: the deep cells `85 ≤ j < 90`

Generated by a script.

Per cell the bound on the rest's damped cosine integral (`RMF.IsRestCosBound`) and the
weight `e^{2B_j + 10⁻¹⁹ - j/40} ≤ w_j`; `RMF/UniformLower/HP2WindowExtNum/Deep1.lean`
collects them.
-/

namespace RMF

attribute [local simp] LeanCert.Core.MathConst.toReal

theorem hp2ExtB_num_85 :
    Real.log (Real.pi * (1 / 2)) - (-3 / 20)
      - (Real.pi * Real.pi * (1 / 4) - Real.exp (2 * (-3 / 20))) * (1 / 4)
      + (Real.pi * Real.pi * Real.pi * Real.pi * (1 / 16) - Real.exp (4 * (-3 / 20)))
        * (1 / 96)
      - Real.exp (-1 - (-3 / 20)) * (1 / 100) * (1 - Real.sin (Real.exp (-3 / 20)))
      + Real.exp (-2 - 2 * (-3 / 20)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (-3 / 20) * Real.sin (Real.exp (-3 / 20))
          - Real.cos (Real.exp (-3 / 20))) ≤ 0.2268 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_85 : IsRestCosBound (hp2DeepEnd 86) (hp2DeepEnd 85) 0.2268 := by
  rw [hp2DeepEnd_eq_exp 86 (ℓ := -3 / 20) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_85

theorem hp2ExtW_85 :
    Real.exp (2 * 0.2268 + 1 / 10 ^ 19 - ((85 : ℕ) : ℝ) / 40) ≤ 0.187988 := by
  simp only [Nat.cast_ofNat]
  interval_decide (trust := kernel)

