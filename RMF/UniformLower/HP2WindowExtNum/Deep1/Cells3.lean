import RMF.UniformLower.HP2WindowExt.Cells

/-!
# Numerals for HP2's window integral with the rest: the deep cells `65 ≤ j < 70`

Generated by a script.

Per cell the bound on the rest's damped cosine integral (`RMF.IsRestCosBound`) and the
weight `e^{2B_j + 10⁻¹⁹ - j/40} ≤ w_j`; `RMF/UniformLower/HP2WindowExtNum/Deep1.lean`
collects them.
-/

namespace RMF

attribute [local simp] LeanCert.Core.MathConst.toReal

theorem hp2ExtB_num_65 :
    Real.log (Real.pi * (1 / 2)) - (7 / 20)
      - (Real.pi * Real.pi * (1 / 4) - Real.exp (2 * (7 / 20))) * (1 / 4)
      + (Real.pi * Real.pi * Real.pi * Real.pi * (1 / 16) - Real.exp (4 * (7 / 20)))
        * (1 / 96)
      - Real.exp (-1 - (7 / 20)) * (1 / 100) * (1 - Real.sin (Real.exp (7 / 20)))
      + Real.exp (-2 - 2 * (7 / 20)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (7 / 20) * Real.sin (Real.exp (7 / 20))
          - Real.cos (Real.exp (7 / 20))) ≤ 0.0095 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_65 : IsRestCosBound (hp2DeepEnd 66) (hp2DeepEnd 65) 0.0095 := by
  rw [hp2DeepEnd_eq_exp 66 (ℓ := 7 / 20) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_65

theorem hp2ExtW_65 :
    Real.exp (2 * 0.0095 + 1 / 10 ^ 19 - ((65 : ℕ) : ℝ) / 40) ≤ 0.200693 := by
  simp only [Nat.cast_ofNat]
  interval_decide (trust := kernel)

