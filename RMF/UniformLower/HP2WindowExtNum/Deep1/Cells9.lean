import RMF.UniformLower.HP2WindowExt.Cells

/-!
# Numerals for HP2's window integral with the rest: the deep cells `95 ≤ j < 100`

Generated by a script.

Per cell the bound on the rest's damped cosine integral (`RMF.IsRestCosBound`) and the
weight `e^{2B_j + 10⁻¹⁹ - j/40} ≤ w_j`; `RMF/UniformLower/HP2WindowExtNum/Deep1.lean`
collects them.
-/

namespace RMF

attribute [local simp] LeanCert.Core.MathConst.toReal

theorem hp2ExtB_num_95 :
    Real.log (Real.pi * (1 / 2)) - (-2 / 5)
      - (Real.pi * Real.pi * (1 / 4) - Real.exp (2 * (-2 / 5))) * (1 / 4)
      + (Real.pi * Real.pi * Real.pi * Real.pi * (1 / 16) - Real.exp (4 * (-2 / 5)))
        * (1 / 96)
      - Real.exp (-1 - (-2 / 5)) * (1 / 100) * (1 - Real.sin (Real.exp (-2 / 5)))
      + Real.exp (-2 - 2 * (-2 / 5)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (-2 / 5) * Real.sin (Real.exp (-2 / 5))
          - Real.cos (Real.exp (-2 / 5))) ≤ 0.4065 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_95 : IsRestCosBound (hp2DeepEnd 96) (hp2DeepEnd 95) 0.4065 := by
  rw [hp2DeepEnd_eq_exp 96 (ℓ := -2 / 5) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_95

theorem hp2ExtW_95 :
    Real.exp (2 * 0.4065 + 1 / 10 ^ 19 - ((95 : ℕ) : ℝ) / 40) ≤ 0.209721 := by
  simp only [Nat.cast_ofNat]
  interval_decide (trust := kernel)

