attribute [local simp] LeanCert.Core.MathConst.toReal

theorem hp2ExtB_num_50 :
    Real.exp (-(Real.exp (-(29 / 40)) * Real.pi * (3 / 200)))
        * (Real.log Real.pi - (3 / 4) + 2 * Real.exp (3 / 4) * Real.pi⁻¹ - 1
          - 3 * Real.log (3 / 2))
      + 0.3237 ≤ 0 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_50 : IsRestCosBound (hp2DeepEnd 51) (hp2DeepEnd 50) 0 := by
  rw [hp2DeepEnd_eq_exp 51 (ℓ := 29 / 40) (by norm_num),
    hp2DeepEnd_eq_exp 50 (ℓ := 3 / 4) (by norm_num)]
  refine isRestCosBound_exp_neg_low ?_ (Real.exp_le_exp.2 (by norm_num)) ?_
    (by norm_num) hp2ExtB_num_50
  · rw [← hp2DeepEnd_eq_exp 51 (ℓ := 29 / 40) (by norm_num)]
    exact pi_div_two_le_hp2DeepEnd (by norm_num)
  · rw [← hp2DeepEnd_eq_exp 50 (ℓ := 3 / 4) (by norm_num)]
    exact hp2DeepEnd_le_pi (by norm_num)

