      + (Real.pi * Real.pi * Real.pi * Real.pi * (1 / 16) - Real.exp (4 * (-39 / 10)))
        * (1 / 96)
      - Real.exp (-1 - (-39 / 10)) * (1 / 100) * (1 - Real.sin (Real.exp (-39 / 10)))
      + Real.exp (-2 - 2 * (-39 / 10)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (-39 / 10) * Real.sin (Real.exp (-39 / 10))
          - Real.cos (Real.exp (-39 / 10))) ≤ 3.6298 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_235 : IsRestCosBound (hp2DeepEnd 236) (hp2DeepEnd 235) 3.6298 := by
  rw [hp2DeepEnd_eq_exp 236 (ℓ := -39 / 10) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_235

