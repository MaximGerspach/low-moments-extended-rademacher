      + Real.exp (-2 - 2 * (-131 / 40)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (-131 / 40) * Real.sin (Real.exp (-131 / 40))
          - Real.cos (Real.exp (-131 / 40))) ≤ 3.0828 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_210 : IsRestCosBound (hp2DeepEnd 211) (hp2DeepEnd 210) 3.0828 := by
  rw [hp2DeepEnd_eq_exp 211 (ℓ := -131 / 40) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_210

