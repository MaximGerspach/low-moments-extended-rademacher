        * (Real.pi * (1 / 2) - Real.exp (-73 / 20) * Real.sin (Real.exp (-73 / 20))
          - Real.cos (Real.exp (-73 / 20))) ≤ 3.4163 := by
  interval_decide (trust := kernel)

