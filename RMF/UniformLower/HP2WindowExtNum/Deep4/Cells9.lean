      + (Real.pi * Real.pi * Real.pi * Real.pi * (1 / 16) - Real.exp (4 * (-83 / 20)))
        * (1 / 96)
      - Real.exp (-1 - (-83 / 20)) * (1 / 100) * (1 - Real.sin (Real.exp (-83 / 20)))
      + Real.exp (-2 - 2 * (-83 / 20)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (-83 / 20) * Real.sin (Real.exp (-83 / 20))
          - Real.cos (Real.exp (-83 / 20))) ≤ 3.8342 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_245 : IsRestCosBound (hp2DeepEnd 246) (hp2DeepEnd 245) 3.8342 := by
  rw [hp2DeepEnd_eq_exp 246 (ℓ := -83 / 20) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_245

