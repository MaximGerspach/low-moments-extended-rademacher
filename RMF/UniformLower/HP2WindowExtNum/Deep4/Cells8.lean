      + (Real.pi * Real.pi * Real.pi * Real.pi * (1 / 16) - Real.exp (4 * (-161 / 40)))
        * (1 / 96)
      - Real.exp (-1 - (-161 / 40)) * (1 / 100) * (1 - Real.sin (Real.exp (-161 / 40)))
      + Real.exp (-2 - 2 * (-161 / 40)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (-161 / 40) * Real.sin (Real.exp (-161 / 40))
          - Real.cos (Real.exp (-161 / 40))) ≤ 3.7332 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_240 : IsRestCosBound (hp2DeepEnd 241) (hp2DeepEnd 240) 3.7332 := by
  rw [hp2DeepEnd_eq_exp 241 (ℓ := -161 / 40) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_240

