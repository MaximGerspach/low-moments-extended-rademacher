attribute [local simp] LeanCert.Core.MathConst.toReal

theorem hp2ExtB_num_215 :
    Real.log (Real.pi * (1 / 2)) - (-17 / 5)
      - (Real.pi * Real.pi * (1 / 4) - Real.exp (2 * (-17 / 5))) * (1 / 4)
      + (Real.pi * Real.pi * Real.pi * Real.pi * (1 / 16) - Real.exp (4 * (-17 / 5)))
        * (1 / 96)
      - Real.exp (-1 - (-17 / 5)) * (1 / 100) * (1 - Real.sin (Real.exp (-17 / 5)))
      + Real.exp (-2 - 2 * (-17 / 5)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (-17 / 5) * Real.sin (Real.exp (-17 / 5))
          - Real.cos (Real.exp (-17 / 5))) ≤ 3.1955 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_215 : IsRestCosBound (hp2DeepEnd 216) (hp2DeepEnd 215) 3.1955 := by
  rw [hp2DeepEnd_eq_exp 216 (ℓ := -17 / 5) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_215

theorem hp2ExtW_215 :
    Real.exp (2 * 3.1955 + 1 / 10 ^ 19 - ((215 : ℕ) : ℝ) / 40) ≤ 2.76218 := by
  simp only [Nat.cast_ofNat]
  interval_decide (trust := kernel)

