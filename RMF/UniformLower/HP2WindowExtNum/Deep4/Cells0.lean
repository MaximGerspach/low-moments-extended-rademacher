      + (Real.pi * Real.pi * Real.pi * Real.pi * (1 / 16) - Real.exp (4 * (-121 / 40)))
        * (1 / 96)
      - Real.exp (-1 - (-121 / 40)) * (1 / 100) * (1 - Real.sin (Real.exp (-121 / 40)))
      + Real.exp (-2 - 2 * (-121 / 40)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (-121 / 40) * Real.sin (Real.exp (-121 / 40))
          - Real.cos (Real.exp (-121 / 40))) ≤ 2.8534 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_200 : IsRestCosBound (hp2DeepEnd 201) (hp2DeepEnd 200) 2.8534 := by
  rw [hp2DeepEnd_eq_exp 201 (ℓ := -121 / 40) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_200

