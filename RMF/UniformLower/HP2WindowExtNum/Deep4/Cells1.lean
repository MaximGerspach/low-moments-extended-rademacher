      + (Real.pi * Real.pi * Real.pi * Real.pi * (1 / 16) - Real.exp (4 * (-63 / 20)))
        * (1 / 96)
      - Real.exp (-1 - (-63 / 20)) * (1 / 100) * (1 - Real.sin (Real.exp (-63 / 20)))
      + Real.exp (-2 - 2 * (-63 / 20)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (-63 / 20) * Real.sin (Real.exp (-63 / 20))
          - Real.cos (Real.exp (-63 / 20))) ≤ 2.9687 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_205 : IsRestCosBound (hp2DeepEnd 206) (hp2DeepEnd 205) 2.9687 := by
  rw [hp2DeepEnd_eq_exp 206 (ℓ := -63 / 20) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_205

