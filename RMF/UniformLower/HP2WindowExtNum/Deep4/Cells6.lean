theorem hp2ExtB_num_230 :
    Real.log (Real.pi * (1 / 2)) - (-151 / 40)
      - (Real.pi * Real.pi * (1 / 4) - Real.exp (2 * (-151 / 40))) * (1 / 4)
      + (Real.pi * Real.pi * Real.pi * Real.pi * (1 / 16) - Real.exp (4 * (-151 / 40)))
        * (1 / 96)
      - Real.exp (-1 - (-151 / 40)) * (1 / 100) * (1 - Real.sin (Real.exp (-151 / 40)))
      + Real.exp (-2 - 2 * (-151 / 40)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (-151 / 40) * Real.sin (Real.exp (-151 / 40))
          - Real.cos (Real.exp (-151 / 40))) ≤ 3.5241 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_230 : IsRestCosBound (hp2DeepEnd 231) (hp2DeepEnd 230) 3.5241 := by
  rw [hp2DeepEnd_eq_exp 231 (ℓ := -151 / 40) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_230

