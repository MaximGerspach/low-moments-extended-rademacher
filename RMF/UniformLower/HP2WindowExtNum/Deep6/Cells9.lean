theorem hp2ExtB_cert_345 : IsRestCosBound (hp2DeepEnd 346) (hp2DeepEnd 345) 4.9767 := by
  rw [hp2DeepEnd_eq_exp 346 (ℓ := -133 / 20) (by norm_num)]
