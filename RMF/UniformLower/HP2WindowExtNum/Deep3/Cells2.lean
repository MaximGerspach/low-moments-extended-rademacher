attribute [local simp] LeanCert.Core.MathConst.toReal

theorem hp2ExtB_num_160 :
    Real.log (Real.pi * (1 / 2)) - (-81 / 40)
      - (Real.pi * Real.pi * (1 / 4) - Real.exp (2 * (-81 / 40))) * (1 / 4)
      + (Real.pi * Real.pi * Real.pi * Real.pi * (1 / 16) - Real.exp (4 * (-81 / 40)))
        * (1 / 96)
      - Real.exp (-1 - (-81 / 40)) * (1 / 100) * (1 - Real.sin (Real.exp (-81 / 40)))
      + Real.exp (-2 - 2 * (-81 / 40)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (-81 / 40) * Real.sin (Real.exp (-81 / 40))
          - Real.cos (Real.exp (-81 / 40))) ≤ 1.9037 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_160 : IsRestCosBound (hp2DeepEnd 161) (hp2DeepEnd 160) 1.9037 := by
  rw [hp2DeepEnd_eq_exp 161 (ℓ := -81 / 40) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_160

theorem hp2ExtW_160 :
    Real.exp (2 * 1.9037 + 1 / 10 ^ 19 - ((160 : ℕ) : ℝ) / 40) ≤ 0.824829 := by
  simp only [Nat.cast_ofNat]
  interval_decide (trust := kernel)

