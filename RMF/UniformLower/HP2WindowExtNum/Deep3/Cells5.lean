attribute [local simp] LeanCert.Core.MathConst.toReal

theorem hp2ExtB_num_175 :
    Real.log (Real.pi * (1 / 2)) - (-12 / 5)
      - (Real.pi * Real.pi * (1 / 4) - Real.exp (2 * (-12 / 5))) * (1 / 4)
      + (Real.pi * Real.pi * Real.pi * Real.pi * (1 / 16) - Real.exp (4 * (-12 / 5)))
        * (1 / 96)
      - Real.exp (-1 - (-12 / 5)) * (1 / 100) * (1 - Real.sin (Real.exp (-12 / 5)))
      + Real.exp (-2 - 2 * (-12 / 5)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (-12 / 5) * Real.sin (Real.exp (-12 / 5))
          - Real.cos (Real.exp (-12 / 5))) ≤ 2.2639 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_175 : IsRestCosBound (hp2DeepEnd 176) (hp2DeepEnd 175) 2.2639 := by
  rw [hp2DeepEnd_eq_exp 176 (ℓ := -12 / 5) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_175

theorem hp2ExtW_175 :
    Real.exp (2 * 2.2639 + 1 / 10 ^ 19 - ((175 : ℕ) : ℝ) / 40) ≤ 1.165116 := by
  simp only [Nat.cast_ofNat]
  interval_decide (trust := kernel)

