        * (Real.pi * (1 / 2) - Real.exp (-43 / 20) * Real.sin (Real.exp (-43 / 20))
          - Real.cos (Real.exp (-43 / 20))) ≤ 2.0241 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_165 : IsRestCosBound (hp2DeepEnd 166) (hp2DeepEnd 165) 2.0241 := by
  rw [hp2DeepEnd_eq_exp 166 (ℓ := -43 / 20) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_165

