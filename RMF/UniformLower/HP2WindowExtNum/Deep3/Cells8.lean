      + (Real.pi * Real.pi * Real.pi * Real.pi * (1 / 16) - Real.exp (4 * (-111 / 40)))
        * (1 / 96)
      - Real.exp (-1 - (-111 / 40)) * (1 / 100) * (1 - Real.sin (Real.exp (-111 / 40)))
      + Real.exp (-2 - 2 * (-111 / 40)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (-111 / 40) * Real.sin (Real.exp (-111 / 40))
          - Real.cos (Real.exp (-111 / 40))) ≤ 2.6199 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_190 : IsRestCosBound (hp2DeepEnd 191) (hp2DeepEnd 190) 2.6199 := by
  rw [hp2DeepEnd_eq_exp 191 (ℓ := -111 / 40) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_190

