theorem hp2ExtB_num_185 :
    Real.log (Real.pi * (1 / 2)) - (-53 / 20)
      - (Real.pi * Real.pi * (1 / 4) - Real.exp (2 * (-53 / 20))) * (1 / 4)
      + (Real.pi * Real.pi * Real.pi * Real.pi * (1 / 16) - Real.exp (4 * (-53 / 20)))
        * (1 / 96)
      - Real.exp (-1 - (-53 / 20)) * (1 / 100) * (1 - Real.sin (Real.exp (-53 / 20)))
      + Real.exp (-2 - 2 * (-53 / 20)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (-53 / 20) * Real.sin (Real.exp (-53 / 20))
          - Real.cos (Real.exp (-53 / 20))) ≤ 2.5019 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_185 : IsRestCosBound (hp2DeepEnd 186) (hp2DeepEnd 185) 2.5019 := by
  rw [hp2DeepEnd_eq_exp 186 (ℓ := -53 / 20) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_185

theorem hp2ExtW_185 :
    Real.exp (2 * 2.5019 + 1 / 10 ^ 19 - ((185 : ℕ) : ℝ) / 40) ≤ 1.460561 := by
  simp only [Nat.cast_ofNat]
  interval_decide (trust := kernel)

