theorem hp2ExtB_num_155 :
    Real.log (Real.pi * (1 / 2)) - (-19 / 10)
      - (Real.pi * Real.pi * (1 / 4) - Real.exp (2 * (-19 / 10))) * (1 / 4)
      + (Real.pi * Real.pi * Real.pi * Real.pi * (1 / 16) - Real.exp (4 * (-19 / 10)))
        * (1 / 96)
      - Real.exp (-1 - (-19 / 10)) * (1 / 100) * (1 - Real.sin (Real.exp (-19 / 10)))
      + Real.exp (-2 - 2 * (-19 / 10)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (-19 / 10) * Real.sin (Real.exp (-19 / 10))
          - Real.cos (Real.exp (-19 / 10))) ≤ 1.7831 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_155 : IsRestCosBound (hp2DeepEnd 156) (hp2DeepEnd 155) 1.7831 := by
  rw [hp2DeepEnd_eq_exp 156 (ℓ := -19 / 10) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_155

