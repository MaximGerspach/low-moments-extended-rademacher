attribute [local simp] LeanCert.Core.MathConst.toReal

theorem hp2ExtB_num_170 :
    Real.log (Real.pi * (1 / 2)) - (-91 / 40)
      - (Real.pi * Real.pi * (1 / 4) - Real.exp (2 * (-91 / 40))) * (1 / 4)
      + (Real.pi * Real.pi * Real.pi * Real.pi * (1 / 16) - Real.exp (4 * (-91 / 40)))
        * (1 / 96)
      - Real.exp (-1 - (-91 / 40)) * (1 / 100) * (1 - Real.sin (Real.exp (-91 / 40)))
      + Real.exp (-2 - 2 * (-91 / 40)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (-91 / 40) * Real.sin (Real.exp (-91 / 40))
          - Real.cos (Real.exp (-91 / 40))) ≤ 2.1442 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_170 : IsRestCosBound (hp2DeepEnd 171) (hp2DeepEnd 170) 2.1442 := by
  rw [hp2DeepEnd_eq_exp 171 (ℓ := -91 / 40) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_170

theorem hp2ExtW_170 :
    Real.exp (2 * 2.1442 + 1 / 10 ^ 19 - ((170 : ℕ) : ℝ) / 40) ≤ 1.039168 := by
  simp only [Nat.cast_ofNat]
  interval_decide (trust := kernel)

