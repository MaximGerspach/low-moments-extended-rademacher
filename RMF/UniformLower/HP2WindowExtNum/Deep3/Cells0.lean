attribute [local simp] LeanCert.Core.MathConst.toReal

theorem hp2ExtB_num_150 :
    Real.log (Real.pi * (1 / 2)) - (-71 / 40)
      - (Real.pi * Real.pi * (1 / 4) - Real.exp (2 * (-71 / 40))) * (1 / 4)
      + (Real.pi * Real.pi * Real.pi * Real.pi * (1 / 16) - Real.exp (4 * (-71 / 40)))
        * (1 / 96)
      - Real.exp (-1 - (-71 / 40)) * (1 / 100) * (1 - Real.sin (Real.exp (-71 / 40)))
      + Real.exp (-2 - 2 * (-71 / 40)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (-71 / 40) * Real.sin (Real.exp (-71 / 40))
          - Real.cos (Real.exp (-71 / 40))) ≤ 1.6626 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_150 : IsRestCosBound (hp2DeepEnd 151) (hp2DeepEnd 150) 1.6626 := by
  rw [hp2DeepEnd_eq_exp 151 (ℓ := -71 / 40) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_150

theorem hp2ExtW_150 :
    Real.exp (2 * 1.6626 + 1 / 10 ^ 19 - ((150 : ℕ) : ℝ) / 40) ≤ 0.653914 := by
  simp only [Nat.cast_ofNat]
  interval_decide (trust := kernel)

