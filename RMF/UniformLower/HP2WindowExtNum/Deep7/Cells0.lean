  interval_decide (trust := kernel)

theorem hp2ExtB_cert_350 : IsRestCosBound (hp2DeepEnd 351) (hp2DeepEnd 350) 4.9875 := by
  rw [hp2DeepEnd_eq_exp 351 (ℓ := -271 / 40) (by norm_num)]
  refine isRestCosBound_exp_large_sat ?_ (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_350
  rw [← hp2DeepEnd_eq_exp 351 (ℓ := -271 / 40) (by norm_num)]
  exact hp2DeepEnd_anti (by norm_num)

