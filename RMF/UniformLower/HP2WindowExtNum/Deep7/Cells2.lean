            + Real.exp (4 + 4 * (-281 / 40)) * 600000000))
        * (1 / 24)) ≤ 5.004 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_360 : IsRestCosBound (hp2DeepEnd 361) (hp2DeepEnd 360) 5.004 := by
  rw [hp2DeepEnd_eq_exp 361 (ℓ := -281 / 40) (by norm_num)]
  refine isRestCosBound_exp_large_sat ?_ (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_360
  rw [← hp2DeepEnd_eq_exp 361 (ℓ := -281 / 40) (by norm_num)]
  exact hp2DeepEnd_anti (by norm_num)

