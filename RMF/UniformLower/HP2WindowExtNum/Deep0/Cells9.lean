theorem hp2ExtB_num_45 :
    Real.exp (-(Real.exp (-(17 / 20)) * Real.pi * (3 / 200)))
        * (Real.log Real.pi - (7 / 8) + 2 * Real.exp (7 / 8) * Real.pi⁻¹ - 1
          - 3 * Real.log (3 / 2))
      + 0.3237 ≤ 0 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_45 : IsRestCosBound (hp2DeepEnd 46) (hp2DeepEnd 45) 0 := by
  rw [hp2DeepEnd_eq_exp 46 (ℓ := 17 / 20) (by norm_num),
    hp2DeepEnd_eq_exp 45 (ℓ := 7 / 8) (by norm_num)]
  refine isRestCosBound_exp_neg_low ?_ (Real.exp_le_exp.2 (by norm_num)) ?_
    (by norm_num) hp2ExtB_num_45
  · rw [← hp2DeepEnd_eq_exp 46 (ℓ := 17 / 20) (by norm_num)]
    exact pi_div_two_le_hp2DeepEnd (by norm_num)
  · rw [← hp2DeepEnd_eq_exp 45 (ℓ := 7 / 8) (by norm_num)]
    exact hp2DeepEnd_le_pi (by norm_num)

