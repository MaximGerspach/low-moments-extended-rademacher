    hp2DeepEnd_eq_exp 35 (ℓ := 9 / 8) (by norm_num)]
  refine isRestCosBound_exp_neg_low ?_ (Real.exp_le_exp.2 (by norm_num)) ?_
    (by norm_num) hp2ExtB_num_35
  · rw [← hp2DeepEnd_eq_exp 36 (ℓ := 11 / 10) (by norm_num)]
    exact pi_div_two_le_hp2DeepEnd (by norm_num)
  · rw [← hp2DeepEnd_eq_exp 35 (ℓ := 9 / 8) (by norm_num)]
    exact hp2DeepEnd_le_pi (by norm_num)

