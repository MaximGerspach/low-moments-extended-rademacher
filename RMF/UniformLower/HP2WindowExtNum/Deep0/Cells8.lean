theorem hp2ExtB_num_40 :
    Real.exp (-(Real.exp (-(39 / 40)) * Real.pi * (3 / 200)))
        * (Real.log Real.pi - 1 + 2 * Real.exp 1 * Real.pi⁻¹ - 1
          - 3 * Real.log (3 / 2))
      + 0.3237 ≤ 0 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_40 : IsRestCosBound (hp2DeepEnd 41) (hp2DeepEnd 40) 0 := by
  rw [hp2DeepEnd_eq_exp 41 (ℓ := 39 / 40) (by norm_num),
    hp2DeepEnd_eq_exp 40 (ℓ := 1) (by norm_num)]
  refine isRestCosBound_exp_neg_low ?_ (Real.exp_le_exp.2 (by norm_num)) ?_
    (by norm_num) hp2ExtB_num_40
  · rw [← hp2DeepEnd_eq_exp 41 (ℓ := 39 / 40) (by norm_num)]
    exact pi_div_two_le_hp2DeepEnd (by norm_num)
  · rw [← hp2DeepEnd_eq_exp 40 (ℓ := 1) (by norm_num)]
    exact hp2DeepEnd_le_pi (by norm_num)

