attribute [local simp] LeanCert.Core.MathConst.toReal

theorem hp2ExtB_num_115 :
    Real.log (Real.pi * (1 / 2)) - (-9 / 10)
      - (Real.pi * Real.pi * (1 / 4) - Real.exp (2 * (-9 / 10))) * (1 / 4)
      + (Real.pi * Real.pi * Real.pi * Real.pi * (1 / 16) - Real.exp (4 * (-9 / 10)))
        * (1 / 96)
      - Real.exp (-1 - (-9 / 10)) * (1 / 100) * (1 - Real.sin (Real.exp (-9 / 10)))
      + Real.exp (-2 - 2 * (-9 / 10)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (-9 / 10) * Real.sin (Real.exp (-9 / 10))
          - Real.cos (Real.exp (-9 / 10))) ≤ 0.8339 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_115 : IsRestCosBound (hp2DeepEnd 116) (hp2DeepEnd 115) 0.8339 := by
  rw [hp2DeepEnd_eq_exp 116 (ℓ := -9 / 10) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_115

theorem hp2ExtW_115 :
    Real.exp (2 * 0.8339 + 1 / 10 ^ 19 - ((115 : ℕ) : ℝ) / 40) ≤ 0.29904 := by
  simp only [Nat.cast_ofNat]
  interval_decide (trust := kernel)

