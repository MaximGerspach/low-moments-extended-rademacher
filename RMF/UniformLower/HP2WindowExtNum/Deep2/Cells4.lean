import RMF.UniformLower.HP2WindowExt.Cells

/-!
# Numerals for HP2's window integral with the rest: the deep cells `120 ≤ j < 125`

Generated by a script.

Per cell the bound on the rest's damped cosine integral (`RMF.IsRestCosBound`) and the
weight `e^{2B_j + 10⁻¹⁹ - j/40} ≤ w_j`; `RMF/UniformLower/HP2WindowExtNum/Deep2.lean`
collects them.
-/

namespace RMF

attribute [local simp] LeanCert.Core.MathConst.toReal

theorem hp2ExtB_num_120 :
    Real.log (Real.pi * (1 / 2)) - (-41 / 40)
      - (Real.pi * Real.pi * (1 / 4) - Real.exp (2 * (-41 / 40))) * (1 / 4)
      + (Real.pi * Real.pi * Real.pi * Real.pi * (1 / 16) - Real.exp (4 * (-41 / 40)))
        * (1 / 96)
      - Real.exp (-1 - (-41 / 40)) * (1 / 100) * (1 - Real.sin (Real.exp (-41 / 40)))
      + Real.exp (-2 - 2 * (-41 / 40)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (-41 / 40) * Real.sin (Real.exp (-41 / 40))
          - Real.cos (Real.exp (-41 / 40))) ≤ 0.9487 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_120 : IsRestCosBound (hp2DeepEnd 121) (hp2DeepEnd 120) 0.9487 := by
  rw [hp2DeepEnd_eq_exp 121 (ℓ := -41 / 40) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_120

theorem hp2ExtW_120 :
    Real.exp (2 * 0.9487 + 1 / 10 ^ 19 - ((120 : ℕ) : ℝ) / 40) ≤ 0.332014 := by
  simp only [Nat.cast_ofNat]
  interval_decide (trust := kernel)

