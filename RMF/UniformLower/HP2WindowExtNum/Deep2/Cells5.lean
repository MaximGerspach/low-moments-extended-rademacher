attribute [local simp] LeanCert.Core.MathConst.toReal

theorem hp2ExtB_num_125 :
    Real.log (Real.pi * (1 / 2)) - (-23 / 20)
      - (Real.pi * Real.pi * (1 / 4) - Real.exp (2 * (-23 / 20))) * (1 / 4)
      + (Real.pi * Real.pi * Real.pi * Real.pi * (1 / 16) - Real.exp (4 * (-23 / 20)))
        * (1 / 96)
      - Real.exp (-1 - (-23 / 20)) * (1 / 100) * (1 - Real.sin (Real.exp (-23 / 20)))
      + Real.exp (-2 - 2 * (-23 / 20)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (-23 / 20) * Real.sin (Real.exp (-23 / 20))
          - Real.cos (Real.exp (-23 / 20))) ≤ 1.0653 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_125 : IsRestCosBound (hp2DeepEnd 126) (hp2DeepEnd 125) 1.0653 := by
  rw [hp2DeepEnd_eq_exp 126 (ℓ := -23 / 20) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_125

theorem hp2ExtW_125 :
    Real.exp (2 * 1.0653 + 1 / 10 ^ 19 - ((125 : ℕ) : ℝ) / 40) ≤ 0.369953 := by
  simp only [Nat.cast_ofNat]
  interval_decide (trust := kernel)

