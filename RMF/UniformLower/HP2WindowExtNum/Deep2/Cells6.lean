attribute [local simp] LeanCert.Core.MathConst.toReal

theorem hp2ExtB_num_130 :
    Real.log (Real.pi * (1 / 2)) - (-51 / 40)
      - (Real.pi * Real.pi * (1 / 4) - Real.exp (2 * (-51 / 40))) * (1 / 4)
      + (Real.pi * Real.pi * Real.pi * Real.pi * (1 / 16) - Real.exp (4 * (-51 / 40)))
        * (1 / 96)
      - Real.exp (-1 - (-51 / 40)) * (1 / 100) * (1 - Real.sin (Real.exp (-51 / 40)))
      + Real.exp (-2 - 2 * (-51 / 40)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (-51 / 40) * Real.sin (Real.exp (-51 / 40))
          - Real.cos (Real.exp (-51 / 40))) ≤ 1.1833 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_130 : IsRestCosBound (hp2DeepEnd 131) (hp2DeepEnd 130) 1.1833 := by
  rw [hp2DeepEnd_eq_exp 131 (ℓ := -51 / 40) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_130

theorem hp2ExtW_130 :
    Real.exp (2 * 1.1833 + 1 / 10 ^ 19 - ((130 : ℕ) : ℝ) / 40) ≤ 0.413384 := by
  simp only [Nat.cast_ofNat]
  interval_decide (trust := kernel)

