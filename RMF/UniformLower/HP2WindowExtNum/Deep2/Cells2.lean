attribute [local simp] LeanCert.Core.MathConst.toReal

theorem hp2ExtB_num_110 :
    Real.log (Real.pi * (1 / 2)) - (-31 / 40)
      - (Real.pi * Real.pi * (1 / 4) - Real.exp (2 * (-31 / 40))) * (1 / 4)
      + (Real.pi * Real.pi * Real.pi * Real.pi * (1 / 16) - Real.exp (4 * (-31 / 40)))
        * (1 / 96)
      - Real.exp (-1 - (-31 / 40)) * (1 / 100) * (1 - Real.sin (Real.exp (-31 / 40)))
      + Real.exp (-2 - 2 * (-31 / 40)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (-31 / 40) * Real.sin (Real.exp (-31 / 40))
          - Real.cos (Real.exp (-31 / 40))) ≤ 0.7215 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_110 : IsRestCosBound (hp2DeepEnd 111) (hp2DeepEnd 110) 0.7215 := by
  rw [hp2DeepEnd_eq_exp 111 (ℓ := -31 / 40) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_110

theorem hp2ExtW_110 :
    Real.exp (2 * 0.7215 + 1 / 10 ^ 19 - ((110 : ℕ) : ℝ) / 40) ≤ 0.270637 := by
  simp only [Nat.cast_ofNat]
  interval_decide (trust := kernel)

