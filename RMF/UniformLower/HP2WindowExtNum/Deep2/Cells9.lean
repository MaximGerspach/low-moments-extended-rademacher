attribute [local simp] LeanCert.Core.MathConst.toReal

theorem hp2ExtB_num_145 :
    Real.log (Real.pi * (1 / 2)) - (-33 / 20)
      - (Real.pi * Real.pi * (1 / 4) - Real.exp (2 * (-33 / 20))) * (1 / 4)
      + (Real.pi * Real.pi * Real.pi * Real.pi * (1 / 16) - Real.exp (4 * (-33 / 20)))
        * (1 / 96)
      - Real.exp (-1 - (-33 / 20)) * (1 / 100) * (1 - Real.sin (Real.exp (-33 / 20)))
      + Real.exp (-2 - 2 * (-33 / 20)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (-33 / 20) * Real.sin (Real.exp (-33 / 20))
          - Real.cos (Real.exp (-33 / 20))) ≤ 1.5421 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_145 : IsRestCosBound (hp2DeepEnd 146) (hp2DeepEnd 145) 1.5421 := by
  rw [hp2DeepEnd_eq_exp 146 (ℓ := -33 / 20) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_145

theorem hp2ExtW_145 :
    Real.exp (2 * 1.5421 + 1 / 10 ^ 19 - ((145 : ℕ) : ℝ) / 40) ≤ 0.582294 := by
  simp only [Nat.cast_ofNat]
  interval_decide (trust := kernel)

