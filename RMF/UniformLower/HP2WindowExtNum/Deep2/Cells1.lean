attribute [local simp] LeanCert.Core.MathConst.toReal

theorem hp2ExtB_num_105 :
    Real.log (Real.pi * (1 / 2)) - (-13 / 20)
      - (Real.pi * Real.pi * (1 / 4) - Real.exp (2 * (-13 / 20))) * (1 / 4)
      + (Real.pi * Real.pi * Real.pi * Real.pi * (1 / 16) - Real.exp (4 * (-13 / 20)))
        * (1 / 96)
      - Real.exp (-1 - (-13 / 20)) * (1 / 100) * (1 - Real.sin (Real.exp (-13 / 20)))
      + Real.exp (-2 - 2 * (-13 / 20)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (-13 / 20) * Real.sin (Real.exp (-13 / 20))
          - Real.cos (Real.exp (-13 / 20))) ≤ 0.6121 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_105 : IsRestCosBound (hp2DeepEnd 106) (hp2DeepEnd 105) 0.6121 := by
  rw [hp2DeepEnd_eq_exp 106 (ℓ := -13 / 20) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_105

theorem hp2ExtW_105 :
    Real.exp (2 * 0.6121 + 1 / 10 ^ 19 - ((105 : ℕ) : ℝ) / 40) ≤ 0.246405 := by
  simp only [Nat.cast_ofNat]
  interval_decide (trust := kernel)

