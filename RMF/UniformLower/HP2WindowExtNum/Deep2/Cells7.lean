theorem hp2ExtB_num_135 :
    Real.log (Real.pi * (1 / 2)) - (-7 / 5)
      - (Real.pi * Real.pi * (1 / 4) - Real.exp (2 * (-7 / 5))) * (1 / 4)
      + (Real.pi * Real.pi * Real.pi * Real.pi * (1 / 16) - Real.exp (4 * (-7 / 5)))
        * (1 / 96)
      - Real.exp (-1 - (-7 / 5)) * (1 / 100) * (1 - Real.sin (Real.exp (-7 / 5)))
      + Real.exp (-2 - 2 * (-7 / 5)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (-7 / 5) * Real.sin (Real.exp (-7 / 5))
          - Real.cos (Real.exp (-7 / 5))) ≤ 1.3022 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_135 : IsRestCosBound (hp2DeepEnd 136) (hp2DeepEnd 135) 1.3022 := by
  rw [hp2DeepEnd_eq_exp 136 (ℓ := -7 / 5) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_135

