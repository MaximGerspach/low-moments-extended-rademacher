import RMF.UniformLower.HP2WindowExt.Cells

/-!
# Numerals for HP2's window integral with the rest: the deep cells `100 ≤ j < 105`

Generated by a script.

Per cell the bound on the rest's damped cosine integral (`RMF.IsRestCosBound`) and the
weight `e^{2B_j + 10⁻¹⁹ - j/40} ≤ w_j`; `RMF/UniformLower/HP2WindowExtNum/Deep2.lean`
collects them.
-/

namespace RMF

attribute [local simp] LeanCert.Core.MathConst.toReal

theorem hp2ExtB_num_100 :
    Real.log (Real.pi * (1 / 2)) - (-21 / 40)
      - (Real.pi * Real.pi * (1 / 4) - Real.exp (2 * (-21 / 40))) * (1 / 4)
      + (Real.pi * Real.pi * Real.pi * Real.pi * (1 / 16) - Real.exp (4 * (-21 / 40)))
        * (1 / 96)
      - Real.exp (-1 - (-21 / 40)) * (1 / 100) * (1 - Real.sin (Real.exp (-21 / 40)))
      + Real.exp (-2 - 2 * (-21 / 40)) * (1 / 20000)
        * (Real.pi * (1 / 2) - Real.exp (-21 / 40) * Real.sin (Real.exp (-21 / 40))
          - Real.cos (Real.exp (-21 / 40))) ≤ 0.5068 := by
  interval_decide (trust := kernel)

theorem hp2ExtB_cert_100 : IsRestCosBound (hp2DeepEnd 101) (hp2DeepEnd 100) 0.5068 := by
  rw [hp2DeepEnd_eq_exp 101 (ℓ := -21 / 40) (by norm_num)]
  exact isRestCosBound_exp_small (hp2DeepEnd_le_pi_div_two (by norm_num))
    hp2ExtB_num_100

theorem hp2ExtW_100 :
    Real.exp (2 * 0.5068 + 1 / 10 ^ 19 - ((100 : ℕ) : ℝ) / 40) ≤ 0.22619 := by
  simp only [Nat.cast_ofNat]
  interval_decide (trust := kernel)

