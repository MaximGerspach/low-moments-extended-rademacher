    {T : ℝ} (hT : ξ ≤ T) : -cosExpInt ξ T ≤ 0 := by
  obtain ⟨⟨z0l, z0u⟩, ⟨z1l, z1u⟩, ⟨z2l, z2u⟩, ⟨z3l, z3u⟩, ⟨z4l, z4u⟩, ⟨z5l, z5u⟩⟩ :=
    hp2Z_numerals
  obtain ⟨l2l, l2u⟩ := log_two_numerals
  have hc := push_core_z1 hT
  have hvs := le_cosExpInt_corner (a := ξ) (b := (hp2Z 1))
    (a' := (-29 / 40)) (b' := (hp2Z 1))
    (cosExpInt_nonpos_rev
      (cosExpInt_nonneg_le_z0 (by linarith) (by linarith)))
    (by rw [cosExpInt_self])
  have hv := cosExpInt_mem_anti (p := (-29 / 40)) (q := (hp2Z 1))
    (by linarith) (by linarith) (by linarith)
  have hva := hp2Anchor_11
  have hvb := hp2AnchorA_z1
  refine neg_le_of_push_core hc (V := 0.007441) ?_ (by norm_num) (by norm_num)
  linarith [hvs, hv.1, hv.2, hva.1, hva.2, hvb.1, hvb.2]

