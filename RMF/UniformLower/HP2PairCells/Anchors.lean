/-- `Φ(z_2) ∈ [0.123193, 0.123198]`. -/
theorem hp2AnchorPhi_z2 :
    0.123193 ≤ cosExpTail (hp2Z 2) ∧ cosExpTail (hp2Z 2) ≤ 0.123198 := by
  rw [show cosExpTail (hp2Z 2) = (2 * (π⁻¹ * (1 / 5)))
      - 2 * ((2 * (π⁻¹ * (1 / 5))) * (2 * (π⁻¹ * (1 / 5))) * (2 * (π⁻¹ * (1 / 5)))) by
