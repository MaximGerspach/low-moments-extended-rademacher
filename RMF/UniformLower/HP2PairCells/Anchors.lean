import RMF.UniformLower.HP2PairCells.Anchors.Rows0
import RMF.UniformLower.HP2PairCells.Anchors.Rows1
import RMF.UniformLower.HP2PairCells.Anchors.Rows2
import RMF.UniformLower.HP2PairCells.Anchors.Rows3

/-!
# HP2's anchors: certified values of the antiderivatives of `cos(e^v)`

Generated by a script.  Brackets of Taylor's
antiderivative `A = RMF.cosExpAnti` on the grid `p_i = -1 + i/40`, `i = 0, …, 120`
(`RMF.hp2Anchor_i`) and at the special points `log 2 - 1`, `log 2`, `log 2 + 1`, `z₀`, `z₁`,
`z_n - 2` (`n = 2, 3, 4`), `z_n = RMF.hp2Z n = log((2n+1)π/2)` the zeros of `cos(e^v)`; brackets of
the asymptotic antiderivative `Φ = RMF.cosExpTail` at `z₂, …, z₅`, where
`Φ(z_n) = (-1)ⁿ(t - 2t³)`, `t = 2/((2n+1)π)` (`RMF.cosExpTail_hp2Z`).  Each bracket by
`interval_decide (trust := kernel)`, rounded outward to `10⁻⁶`.  The grid's brackets are in
`RMF/UniformLower/HP2PairCells/Anchors/Rows0.lean`, …, `Rows3.lean`.
-/

open Real

namespace RMF

attribute [local simp] LeanCert.Core.MathConst.toReal

/-- **The zeros of `cos(e^v)`**: `z_n = log((2n+1)π/2)`. -/
noncomputable def hp2Z (n : ℕ) : ℝ := Real.log ((2 * n + 1) * π / 2)

lemma exp_hp2Z (n : ℕ) : Real.exp (hp2Z n) = (2 * n + 1) * π / 2 :=
  Real.exp_log (by positivity)

/-- `RMF.cosExpAnti` at `log y` in Horner form in `y²`, for interval arithmetic. -/
lemma cosExpAnti_log_eq_horner {y : ℝ} (hy : 0 < y) :
    cosExpAnti (Real.log y) =
      Real.log y + (y * y) * ((-1 / 4) + (y * y) * ((1 / 96) + (y * y) * ((-1 /
      4320) + (y * y) * ((1 / 322560) + (y * y) * ((-1 / 36288000) + (y * y) * ((1 /
      5748019200) + (y * y) * ((-1 / 1220496076800) + (y * y) * ((1 /
      334764638208000) + (y * y) * ((-1 / 115242726703104000) + (y * y) * ((1 /
      48658040163532800000) + (y * y) * ((-1 / 24728016011107368960000) + (y * y)
      * ((1 / 14890761641597746544640000) + (y * y) * ((-1 / 10485577989291746525184000000)
      + (y * y) * ((1 / 8536873649127988094042112000000) + (y * y) * (-1 /
      7957585794365731759089254400000000))))))))))))))) := by
  have h : Real.exp (2 * Real.log y) = y * y := by
    rw [show 2 * Real.log y = Real.log y + Real.log y by ring, Real.exp_add, Real.exp_log hy]
  rw [cosExpAnti_eq_horner, h]

/-- **`Φ` at the zeros**: `Φ(z_n) = (-1)ⁿ(t - 2t³)`, `t = e^{-z_n} = 2/((2n+1)π)`
(`sin((2n+1)π/2) = (-1)ⁿ`, `cos((2n+1)π/2) = 0`). -/
lemma cosExpTail_hp2Z (n : ℕ) :
    cosExpTail (hp2Z n) = (-1) ^ n * (2 / ((2 * n + 1) * π)
      - 2 * ((2 / ((2 * n + 1) * π)) * (2 / ((2 * n + 1) * π)) * (2 / ((2 * n + 1) * π)))) := by
  have he : Real.exp (hp2Z n) = n * π + π / 2 := by rw [exp_hp2Z]; ring
  have hs : Real.sin (Real.exp (hp2Z n)) = (-1) ^ n := by
    rw [he, Real.sin_add_pi_div_two, Real.cos_nat_mul_pi]
  have hc : Real.cos (Real.exp (hp2Z n)) = 0 := by
    rw [he, Real.cos_add_pi_div_two, Real.sin_nat_mul_pi, neg_zero]
  have h1 : Real.exp (-hp2Z n) = 2 / ((2 * n + 1) * π) := by
    rw [Real.exp_neg, exp_hp2Z]
    field_simp
  have h3 : Real.exp (-(3 * hp2Z n)) = (2 / ((2 * n + 1) * π)) * (2 / ((2 * n + 1) * π))
      * (2 / ((2 * n + 1) * π)) := by
    rw [show -(3 * hp2Z n) = -hp2Z n + -hp2Z n + -hp2Z n by ring, Real.exp_add, Real.exp_add,
      h1]
  rw [cosExpTail, hs, hc, h1, h3]
  ring

/-! ### The special points -/

/-- `A(Real.log 2 - 1) ∈ [-0.439174, -0.439169]`. -/
theorem hp2AnchorA_log_two_sub_one :
    (-0.439174) ≤ cosExpAnti (Real.log 2 - 1) ∧ cosExpAnti (Real.log 2 - 1) ≤ (-0.439169) := by
  rw [show Real.log 2 - 1 = Real.log (2 * Real.exp (-1)) by
    rw [Real.log_mul (by norm_num) (Real.exp_pos _).ne', Real.log_exp]; ring]
  rw [cosExpAnti_log_eq_horner (by positivity)]
  constructor <;> interval_decide (trust := kernel)

/-- `A(Real.log 2) ∈ [-0.154237, -0.154232]`. -/
theorem hp2AnchorA_log_two :
    (-0.154237) ≤ cosExpAnti (Real.log 2) ∧ cosExpAnti (Real.log 2) ≤ (-0.154232) := by
  rw [cosExpAnti_log_eq_horner (by norm_num)]
  constructor <;> interval_decide (trust := kernel)

/-- `A(Real.log 2 + 1) ∈ [-0.727227, -0.727222]`. -/
theorem hp2AnchorA_log_two_add_one :
    (-0.727227) ≤ cosExpAnti (Real.log 2 + 1) ∧ cosExpAnti (Real.log 2 + 1) ≤ (-0.727222) := by
  rw [show Real.log 2 + 1 = Real.log (2 * Real.exp 1) by
    rw [Real.log_mul (by norm_num) (Real.exp_pos _).ne', Real.log_exp]]
  rw [cosExpAnti_log_eq_horner (by positivity)]
  constructor <;> interval_decide (trust := kernel)

