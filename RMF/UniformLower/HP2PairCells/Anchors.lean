  rw [show hp2Z 0 = Real.log (Real.pi * (1 / 2)) by
    unfold hp2Z; congr 1; push_cast; ring]
  rw [cosExpAnti_log_eq_horner (by positivity)]
  constructor <;> interval_decide (trust := kernel)

