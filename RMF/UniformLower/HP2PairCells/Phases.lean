/-- **`J(1 + x, 2)` over the phases**: in `[-0.31329, 0.30812]`. -/
theorem hp2Phase_one_two {x : ℝ} (h₁ : Real.log 2 - 1 ≤ x) (h₂ : x ≤ Real.log 2) :
    (-0.31329) ≤ cosExpInt (1 + x) 2 ∧ cosExpInt (1 + x) 2 ≤ 0.30812 := by
  obtain ⟨⟨z0l, z0u⟩, ⟨z1l, z1u⟩, ⟨z2l, z2u⟩, ⟨z3l, z3u⟩, ⟨z4l, z4u⟩, ⟨z5l, z5u⟩⟩ :=
    hp2Z_numerals
  obtain ⟨l2l, l2u⟩ := log_two_numerals
  constructor
  · refine le_trans (le_min ?_ ?_) (cosExpInt_phase_one_two_ge h₁ h₂)
    · have hw := cosExpInt_mem_anti (p := (Real.log 2)) (q := 2)
        (by linarith) (by linarith) (by linarith)
      have hwa := hp2AnchorA_log_two
      have hwb := hp2Anchor_120
      linarith [hw.1, hw.2, hwa.1, hwa.2, hwb.1, hwb.2]
    · have hx := cosExpInt_mem_anti (p := (Real.log 2 + 1)) (q := 2)
        (by linarith) (by linarith) (by linarith)
      have hxa := hp2AnchorA_log_two_add_one
      have hxb := hp2Anchor_120
      linarith [hx.1, hx.2, hxa.1, hxa.2, hxb.1, hxb.2]
  · refine (cosExpInt_phase_one_two_le h₁ h₂).trans ?_
    have hv := cosExpInt_mem_anti (p := (hp2Z 1)) (q := 2)
      (by linarith) (by linarith) (by linarith)
    have hva := hp2AnchorA_z1
    have hvb := hp2Anchor_120
    linarith [hv.1, hv.2, hva.1, hva.2, hvb.1, hvb.2]

