import RMF.UniformLower.HP2PairCells.Integral

/-!
# Numerals for HP2's pair cells: the phases

Generated by a script.  For the phases
`x ∈ [log 2 - 1, log 2]` of the window's sum and doubled frequencies (`RMF.log_add_mem_of_window`),
bounds on `J(x, 1 + x)`, `J(x, 2 + x)` (`RMF.hp2Phase_two`, cells of width `1/20` on its first sign
piece), `J(d + x, 2)` and the bridges' `J(d + x, b + x)`, `d ≤ 3`: corner arguments on the sign
pieces of `cos(e^v)` (`RMF.cosExpInt_le_corner`) closed by the anchors
(`RMF/UniformLower/HP2PairCells/Anchors.lean`).
-/

open Real

namespace RMF

/-- **`J(x, 1 + x)` over the phases** (L2 at one block): at most `0.28495`. -/
theorem hp2Phase_one {x : ℝ} (h₁ : Real.log 2 - 1 ≤ x) (h₂ : x ≤ Real.log 2) :
    cosExpInt x (1 + x) ≤ 0.28495 := by
  obtain ⟨⟨z0l, z0u⟩, ⟨z1l, z1u⟩, ⟨z2l, z2u⟩, ⟨z3l, z3u⟩, ⟨z4l, z4u⟩, ⟨z5l, z5u⟩⟩ :=
    hp2Z_numerals
  obtain ⟨l2l, l2u⟩ := log_two_numerals
  refine (cosExpInt_phase_one_le h₁ h₂).trans (max_le ?_ ?_)
  · have hv := cosExpInt_mem_anti (p := (Real.log 2 - 1)) (q := (Real.log 2))
      (by linarith) (by linarith) (by linarith)
    have hva := hp2AnchorA_log_two_sub_one
    have hvb := hp2AnchorA_log_two
    linarith [hv.1, hv.2, hva.1, hva.2, hvb.1, hvb.2]
  · linarith

