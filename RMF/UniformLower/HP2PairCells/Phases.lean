/-- **`J(x, 2 + x)` over the phases** (L2 at two blocks; the bridge at depth `0`): in `[-0.5631,
-0.19964]`, by the sign pieces cut at `z₂ - 2, z₃ - 2, z₀, z₄ - 2` (`RMF.hp2Phase_two_lo_0` …,
`RMF.hp2Phase_two_up_0` …). -/
theorem hp2Phase_two {x : ℝ} (h₁ : Real.log 2 - 1 ≤ x) (h₂ : x ≤ Real.log 2) :
    (-0.5631) ≤ cosExpInt x (2 + x) ∧ cosExpInt x (2 + x) ≤ (-0.19964) := by
  constructor
  · rcases le_total x (hp2Z 2 - 2) with hc0 | hc0
    · linarith [hp2Phase_two_lo_0 h₁ hc0]
    rcases le_total x (hp2Z 3 - 2) with hc1 | hc1
    · linarith [hp2Phase_two_lo_1 hc0 hc1]
    rcases le_total x (hp2Z 0) with hc2 | hc2
    · linarith [hp2Phase_two_lo_2 hc1 hc2]
    rcases le_total x (hp2Z 4 - 2) with hc3 | hc3
    · linarith [hp2Phase_two_lo_3 hc2 hc3]
    linarith [hp2Phase_two_lo_4 hc3 h₂]
  · rcases le_total x (-1 / 4) with hc0 | hc0
    · linarith [hp2Phase_two_up_0 h₁ hc0]
    rcases le_total x (-1 / 5) with hc1 | hc1
    · linarith [hp2Phase_two_up_1 hc0 hc1]
    rcases le_total x (-3 / 20) with hc2 | hc2
    · linarith [hp2Phase_two_up_2 hc1 hc2]
    rcases le_total x (-1 / 10) with hc3 | hc3
    · linarith [hp2Phase_two_up_3 hc2 hc3]
    rcases le_total x (-1 / 20) with hc4 | hc4
    · linarith [hp2Phase_two_up_4 hc3 hc4]
    rcases le_total x 0 with hc5 | hc5
    · linarith [hp2Phase_two_up_5 hc4 hc5]
    rcases le_total x (hp2Z 2 - 2) with hc6 | hc6
    · linarith [hp2Phase_two_up_6 hc5 hc6]
    rcases le_total x (hp2Z 3 - 2) with hc7 | hc7
    · linarith [hp2Phase_two_up_7 hc6 hc7]
    rcases le_total x (hp2Z 0) with hc8 | hc8
    · linarith [hp2Phase_two_up_8 hc7 hc8]
    rcases le_total x (hp2Z 4 - 2) with hc9 | hc9
