import RMF.UniformLower.HP1GridFloor.Cells0
import RMF.UniformLower.HP1GridFloor.Cells1
import RMF.UniformLower.HP1GridFloor.Cells2
import RMF.UniformLower.HP1GridFloor.Cells3
import RMF.UniformLower.HP1GridFloor.Cells4
import RMF.UniformLower.HP1GridFloor.Cells5
import RMF.UniformLower.HP1GridFloor.Cells6
import RMF.UniformLower.HP1GridFloor.Cells7

/-!
# HP1's cell data at the floor `20`: the dispatch

Generated by a script.  On cell `i < 80` of the window at `k ≥ 20` the start ranges of the
per-cell certificate and the block-data hypotheses of `RMF.le_measure_windowEvent_rademacher_floor`
hold at the numerals `RMF.hp1CellTableFloor i` (`RMF.hp1CellData_of_lt_floor`, from the shards
`RMF/UniformLower/HP1GridFloor/Cells*.lean`; the numerals in
`RMF/UniformLower/HP1GridFloor/Table.lean`).
-/

open MeasureTheory

namespace RMF

variable {Ω : Type*} [MeasurableSpace Ω] {X : ℕ → Ω → ℂ} {μ : Measure Ω}

/-- **HP1's data on every cell at the floor**: on cell `i < 80` of the window at `k ≥ 20`, for
`r ≥ 110` blocks with `σe^{k+r} ≤ 1/200` below the cutoff `y`, the data hold at the numerals
`RMF.hp1CellTableFloor i`. -/
theorem hp1CellData_of_lt_floor (hX : IsRademacherPrimeValues X μ) {k r y i : ℕ} {σ h : ℝ}
    (hi : i < 80) (hk : 20 ≤ k) (hh : h ∈ hp1Cell k i) (hσ : 0 ≤ σ)
    (hσr : σ * Real.exp ((k : ℝ) + r) ≤ 1 / 200)
    (hy : ∀ m, m < r → primeBlockSub k m ⊆ primesBelowSub y) (hr : 110 ≤ r) :
    HP1CellData X μ y k r σ h (hp1CellTableFloor i) := by
  rcases (show i ≤ 9 ∨ (10 ≤ i ∧ i ≤ 19) ∨ (20 ≤ i ∧ i ≤ 29) ∨ (30 ≤ i ∧ i ≤ 39)
      ∨ (40 ≤ i ∧ i ≤ 49) ∨ (50 ≤ i ∧ i ≤ 59) ∨ (60 ≤ i ∧ i ≤ 69) ∨ (70 ≤ i ∧ i ≤ 79) by omega)
    with h0 | ⟨h1, h1'⟩ | ⟨h2, h2'⟩ | ⟨h3, h3'⟩ | ⟨h4, h4'⟩ | ⟨h5, h5'⟩ | ⟨h6, h6'⟩ | ⟨h7, h7'⟩
  · exact hp1CellDataFloor_part_0 hX h0 hk hh hσ hσr hy hr
  · exact hp1CellDataFloor_part_1 hX h1 h1' hk hh hσ hσr hy hr
  · exact hp1CellDataFloor_part_2 hX h2 h2' hk hh hσ hσr hy hr
  · exact hp1CellDataFloor_part_3 hX h3 h3' hk hh hσ hσr hy hr
  · exact hp1CellDataFloor_part_4 hX h4 h4' hk hh hσ hσr hy hr
  · exact hp1CellDataFloor_part_5 hX h5 h5' hk hh hσ hσr hy hr
  · exact hp1CellDataFloor_part_6 hX h6 h6' hk hh hσ hσr hy hr
  · exact hp1CellDataFloor_part_7 hX h7 h7' hk hh hσ hσr hy hr

end RMF
